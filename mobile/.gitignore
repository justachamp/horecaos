# Dart and Flutter
.dart_tool/
.packages
build/
*.dart.js
*.info.json
*.js.map

# pubspec.lock is deliberately NOT ignored. This is an application, not a
# package, and a reproducible build is worth more than resolving to the newest
# transitive dependency on every checkout. It is absent today because nothing
# has resolved yet.

# Generated localisations. Regenerated by `flutter gen-l10n`; committing them
# invites a hand edit that the next generation silently discards.
lib/src/l10n/generated/
l10n_untranslated.json

# The android/ and ios/ folders are NOT ignored — they carry the bundle
# identifier, the permission declarations, and the redirect scheme, which are
# ours and not reproducible. They are absent today because Flutter is not
# installed here; see README, "What the first person with Flutter has to run".
# What is ignored is the generated content inside them.
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/.cxx/
ios/Pods/
ios/.symlinks/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
**/Flutter/ephemeral/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/

# Signing material and provider configuration. None of this belongs in git;
# ADR 0028 owns credentials.
.env
*.keystore
*.jks
*.p12
*.mobileprovision
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Editors and tooling
.idea/
*.iml
.vscode/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/

# macOS
.DS_Store
