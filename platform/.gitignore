# Claude Code worktrees
.claude/worktrees/

# The four application repositories, awaiting their remotes.
#
# Each of these is a standalone git repository with its own history, created by
# the frontend foundations work. They are ignored rather than tracked because
# there is nowhere yet to point a submodule at: `git add`ing them would record a
# gitlink with no matching `.gitmodules` entry, and a clone of this repository
# would then fail to resolve a submodule that has no URL.
#
# Once the four remotes exist under the horecaos-one organisation, remove these
# lines and run the commands in frontend/README.md. Nothing else changes; the
# repositories and their histories are already correct.
/frontend/control-plane/
/frontend/operations/
/frontend/storefront/
/frontend/mobile/

# Claude Code local overrides (settings.json IS checked in — it is shared policy)
.claude/settings.local.json

# Control-band sample history is runtime state, not repository content
ops/state/
