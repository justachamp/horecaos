  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/courier/tenants/{tenantId}/brands/{brandId}/locations/{locationId}/cash-handovers/{handoverId}/declaration" : {
      "post" : {
        "description" : "The courier's statement about the bag. A branch cashier confirms what was received separately, and each gap becomes its own variance entry.",
        "operationId" : "declareCash",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "brandId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "locationId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "handoverId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CashDeclarationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Declare the cash I am handing over",
        "tags" : [ "Courier shift" ]
      }
    },
    "/api/v1/courier/tenants/{tenantId}/brands/{brandId}/locations/{locationId}/deliveries" : {
      "get" : {
        "description" : "Assigned, waiting at the pickup, or on the road. Only this courier's own deliveries are ever returned.",
        "operationId" : "courierListDeliveries",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "brandId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "locationId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CourierDeliveryResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "What I am carrying at this branch",
        "tags" : [ "Courier deliveries" ]
      }
    },
    "/api/v1/courier/tenants/{tenantId}/brands/{brandId}/locations/{locationId}/deliveries/{shipmentId}" : {
      "get" : {
        "description" : "Any status. A delivery that is not this courier's answers 404, exactly as one that does not exist. Returns an ETag to send back as If-Match.",
