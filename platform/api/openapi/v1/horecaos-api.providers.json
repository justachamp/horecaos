  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/partner/tenants/{tenantId}/marketplace/shift-events" : {
      "post" : {
        "description" : "Acknowledged whether or not the tenant's own notifications.aggregator_shift_notifications_enabled switch is on; the response says whether an alert was actually raised.",
        "operationId" : "push_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ShiftEventRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShiftEventResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Report that this aggregator's own shift opened or closed for a venue",
        "tags" : [ "Partner API" ]
      }
    },
    "/api/v1/partner/tenants/{tenantId}/orders" : {
      "post" : {
        "description" : "Idempotent on (venue, externalOrderId). A repeat returns the order the first push created, with 200 rather than 201, and never creates a second.",
        "operationId" : "push",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PartnerOrderControllerPushRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PushResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Push an order",
        "tags" : [ "Partner API" ]
      }
    },
    "/api/v1/partner/tenants/{tenantId}/restaurants" : {
      "get" : {
        "description" : "ADR 0040. Each branch the partner's installation is bound to through a live binding, by name, with whether its integration has a single active channel yet (a restaurant whose channelConfigured is false answers 409 CHANNEL_NOT_CONFIGURED on its menu).",
        "operationId" : "partnerRestaurants",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PartnerRestaurantsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the restaurants this credential is bound to",
        "tags" : [ "Partner API" ]
      }
    },
    "/api/v1/partner/tenants/{tenantId}/restaurants/{locationId}/availability" : {
      "get" : {
        "description" : "ADR 0141 Phase 4. For each dish this partner has mapped at the restaurant, whether it may be sold on the partner's channel right now, in the partner's own item-id order and in cursor pages (pass nextCursor back as cursor; limit 1 to 200, default 200). Identifiers and a boolean only. Answered from the platform's own resolver on every call, never from a cache. 404 when the restaurant is not one this credential is bound to; 409 CHANNEL_NOT_CONFIGURED when the integration has no single active channel yet.",
        "operationId" : "read",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "locationId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PartnerAvailabilityResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Read a restaurant's current availability",
        "tags" : [ "Partner API" ]
      }
    },
    "/api/v1/partner/tenants/{tenantId}/restaurants/{locationId}/menu" : {
      "get" : {
        "description" : "ADR 0040 and ADR 0138. The channel's assembled menu at this restaurant: categories, dishes with their sizes (variants), modifier groups, prices in integer minor units, orderability and the pictures the channel shows for each dish, size and category. Every variant carries the platform's variantId and, where the partner has mapped it, its own partnerItemId. The response has an ETag over the whole menu: send it back in If-None-Match to read a 304 while nothing has changed. locale is ru, uz or en; omitted, the brand's own default. 404 when the restaurant is not one this credential is bound to; 409 CHANNEL_NOT_CONFIGURED when the integration has no single active channel yet; 409 MENU_NOT_PUBLISHED when nothing has been published to the channel.",
        "operationId" : "partnerMenu",
        "parameters" : [ {
          "in" : "path",
          "name" : "tenantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "locationId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "locale",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PartnerMenuResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Read a restaurant's menu as its channel serves it",
        "tags" : [ "Partner API" ]
      }
    },
