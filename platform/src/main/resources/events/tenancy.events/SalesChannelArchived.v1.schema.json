{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.horecaos.uz/events/tenancy.events/SalesChannelArchived.v1.schema.json",
  "title": "SalesChannelArchived v1 payload",
  "description": "A sales channel was retired. Carries no personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["channelId", "code", "version"],
  "properties": {
    "channelId": { "type": "string", "format": "uuid" },
    "code": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,31}$" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
