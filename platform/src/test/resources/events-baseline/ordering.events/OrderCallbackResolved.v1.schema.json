{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.horecaos.uz/events/ordering.events/OrderCallbackResolved.v1.schema.json",
  "title": "OrderCallbackResolved v1 payload",
  "description": "A raised callback was cleared (ADR 0039). Carries no identifier for who resolved it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "amendmentId", "orderVersion"],
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "brandId": { "type": ["string", "null"], "format": "uuid" },
    "locationId": { "type": ["string", "null"], "format": "uuid" },
    "amendmentId": { "type": "string", "format": "uuid" },
    "orderVersion": { "type": "integer", "minimum": 1 }
  }
}
