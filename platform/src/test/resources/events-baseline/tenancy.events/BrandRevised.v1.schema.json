{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.horecaos.uz/events/tenancy.events/BrandRevised.v1.schema.json",
  "title": "BrandRevised v1 payload",
  "description": "Emitted after a brand's name, or while it was a draft its code or slug, is corrected. Carries the whole identity after the change, not a diff. Carries no personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["brandId", "code", "slug", "displayName", "status"],
  "properties": {
    "brandId": { "type": "string", "format": "uuid" },
    "code": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,31}$" },
    "slug": { "type": "string", "maxLength": 63 },
    "displayName": { "type": "string", "maxLength": 255 },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "ARCHIVED"]
    }
  }
}
