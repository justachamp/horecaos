# /etc/qoida/alerting.env — root-owned, mode 0600, and not in this repository.
#
# These are the only credentials on the production host that are not in OpenBao,
# and that is a considered exception to ADR 0028 rather than an oversight: the
# alert path must not depend on the thing it is monitoring. A sealed OpenBao or
# a wedged Docker daemon is exactly when the probe has to work.
#
# Copy, fill in, and:
#   sudo chown root:root /etc/qoida/alerting.env
#   sudo chmod 0600 /etc/qoida/alerting.env

# The dead-man's switch. Its silence is the "platform unreachable" alert.
QOIDA_HEARTBEAT_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Loud: rings at 3am. Night alerts and trading-hours alerts inside the window.
QOIDA_ALERT_WEBHOOK_LOUD=https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>

# Quiet: the morning digest. With Telegram, the same URL plus
# &disable_notification=true.
QOIDA_ALERT_WEBHOOK_QUIET=https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>&disable_notification=true

# The public API hostname, used for the certificate expiry check.
QOIDA_API_HOSTNAME=api.qoida.uz

# The filesystem the database, Kafka segments and audit partitions share.
QOIDA_DATA_VOLUME=/

# Touched by the backup cron entry only when infra/backup/backup.sh exits zero.
QOIDA_BACKUP_STAMP=/var/lib/qoida/last-backup
