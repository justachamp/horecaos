# Template for /etc/horecaos/production.env on the colocated host.
#
# Copy it there, edit it, and chmod 0600. It is read by compose.production.yaml
# through --env-file.
#
# Every value in this file is public information. There is no password here, no
# token, and no key, and none may ever be added: credentials reach the containers
# from OpenBao at deploy time, and a value that appears here would be a value in
# a file on the disk. If you find yourself wanting to add one, that is the signal
# to put it in OpenBao and read it in infra/production/deploy.sh instead.
#
# The compose file uses ${VAR:?message} for everything that has no safe default,
# so a missing line fails the deploy immediately with the name of what is missing
# rather than starting something subtly wrong.

# --- Public identity of the deployment ---------------------------------------

# Origins, with scheme. These are what Caddy serves, what Keycloak issues tokens
# for, and what the application validates the `iss` claim against. Changing one
# without the other two is the most common way to make every token invalid.
HORECAOS_API_ORIGIN=https://api.horecaos.uz
HORECAOS_AUTH_ORIGIN=https://auth.horecaos.uz

# The same two names without a scheme. Used as Docker network aliases so the
# application can resolve the auth hostname without leaving the host — see the
# comment on the `edge` service.
HORECAOS_API_HOSTNAME=api.horecaos.uz
HORECAOS_AUTH_HOSTNAME=auth.horecaos.uz

# Where certificate-expiry notices go. A real, monitored mailbox: this is the
# warning that arrives before a full outage.
HORECAOS_ACME_EMAIL=ops@horecaos.uz


# --- Kafka -------------------------------------------------------------------

# Generate ONCE, with `kafka-storage.sh random-uuid`, and never change it. The
# broker refuses to start against a data directory formatted with a different
# cluster id, so changing this value turns into "Kafka will not start and the log
# says nothing obviously related".
HORECAOS_KAFKA_CLUSTER_ID=


# --- Object storage ----------------------------------------------------------

# Not "minioadmin", not "admin", and not the same as anything else. The password
# for it is generated by bootstrap.sh and lives in OpenBao.
HORECAOS_MINIO_ROOT_USER=
HORECAOS_MEDIA_BUCKET=horecaos-media
HORECAOS_MEDIA_REGION=us-east-1


# --- Backups -----------------------------------------------------------------

HORECAOS_BACKUP_BUCKET=horecaos-backups
HORECAOS_BACKUP_S3_ENDPOINT=http://minio:9000
HORECAOS_BACKUP_RETENTION_DAYS=30

# REQUIRED. The nightly backup refuses to run without it, deliberately: a backup
# that exists only on the machine it is backing up is not a backup, and the
# script used to keep local-only copies silently.
#
# The credentials for this destination go in OpenBao under
# production/object_storage/platform/backup-offsite-{access,secret}-key and are
# resolved inside the container -- never here, because this file is readable on
# the host. The bucket needs versioning and object-lock, so that a stolen key can
# add history but not delete it.
#
# The backup passphrase must NOT live in the same account as this destination. A
# place holding both the ciphertext and its key is one compromise away from being
# no encryption at all.
HORECAOS_BACKUP_OFFSITE_ENDPOINT=
HORECAOS_BACKUP_OFFSITE_BUCKET=


# --- Database roles: deliberately NOT here -----------------------------------
#
# There is no HORECAOS_DB_USERNAME line in this file and there must never be one.
# compose.production.yaml pins the application to `horecaos_app` and the migration
# job to `horecaos_migrator`, because which role the application connects as is not
# a site setting — it is the security boundary that makes every GRANT and REVOKE
# in the migrations mean anything. An override here would let a host quietly run
# the application as the database owner, and the difference is invisible from the
# outside: the audit trail stops being immutable, V0059's column-level grant
# stops holding, and nothing fails until an auditor asks.
#
# DatabasePrivilegeGuard refuses to start any non-local profile whose connection
# is a superuser or the database owner, so an override would now fail the deploy
# rather than weaken it silently. That refusal is the backstop, not the design.


# --- Sizing ------------------------------------------------------------------

# Hikari's ceiling. Must stay well under the database's max_connections (100),
# with room for the migration job, the ops container, and a human with psql.
HORECAOS_DB_MAX_POOL_SIZE=20
HORECAOS_DB_MIN_IDLE=4


# --- Set by the deploy script, not by hand -----------------------------------
#
# HORECAOS_IMAGE_TAG     the short git sha being deployed
# HORECAOS_GIT_SHA       the full sha, baked into the image as an OCI label
# HORECAOS_SECRET_DIR    the tmpfs holding the startup secrets
#
# They are listed here only so that nobody adds them to this file and then
# wonders why every deploy ships the same tag.
