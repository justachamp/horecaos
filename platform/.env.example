# Local development. Every value here is worthless outside a laptop.
#
# These are the defaults application.yml already carries, written out so that the
# two roles are visible. The application connects as qoida_app, which owns
# nothing and can issue no DDL; Flyway connects as qoida_migrator, which owns
# every object. compose.yaml creates both. Running the application as the owner
# is what made every GRANT and REVOKE in the migrations a no-op for sixty-one
# migrations, so do not collapse them back into one role.
#
# If your platform-db volume predates the two-role split, recreate it once:
#     docker compose down -v && docker compose up -d
QOIDA_DB_URL=jdbc:postgresql://localhost:5432/qoida
QOIDA_DB_USERNAME=qoida_app
QOIDA_DB_PASSWORD=qoida_app
QOIDA_DB_MIGRATION_USERNAME=qoida_migrator
QOIDA_DB_MIGRATION_PASSWORD=qoida_migrator
QOIDA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
QOIDA_OIDC_ISSUER_URI=http://localhost:8081/realms/qoida
QOIDA_OIDC_AUDIENCE=qoida-api
QOIDA_SECRETS_PROVIDER=openbao
QOIDA_OPENBAO_URL=http://localhost:8200
QOIDA_OPENBAO_TOKEN=qoida-local-root
QOIDA_OPENBAO_MOUNT=qoida
