# Local development. Every value here is worthless outside a laptop.
#
# These are the defaults application.yml already carries, written out so that the
# two roles are visible. The application connects as horecaos_app, which owns
# nothing and can issue no DDL; Flyway connects as horecaos_migrator, which owns
# every object. compose.yaml creates both. Running the application as the owner
# is what made every GRANT and REVOKE in the migrations a no-op for sixty-one
# migrations, so do not collapse them back into one role.
#
# If your platform-db volume predates the two-role split, recreate it once:
#     docker compose down -v && docker compose up -d
HORECAOS_DB_URL=jdbc:postgresql://localhost:5432/horecaos
HORECAOS_DB_USERNAME=horecaos_app
HORECAOS_DB_PASSWORD=horecaos_app
HORECAOS_DB_MIGRATION_USERNAME=horecaos_migrator
HORECAOS_DB_MIGRATION_PASSWORD=horecaos_migrator
HORECAOS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HORECAOS_OIDC_ISSUER_URI=http://localhost:8081/realms/horecaos
HORECAOS_OIDC_AUDIENCE=horecaos-api
HORECAOS_SECRETS_PROVIDER=openbao
HORECAOS_OPENBAO_URL=http://localhost:8200
HORECAOS_OPENBAO_TOKEN=horecaos-local-root
HORECAOS_OPENBAO_MOUNT=horecaos
