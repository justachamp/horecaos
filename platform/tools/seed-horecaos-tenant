cat <<SUMMARY | tee -a "${LOG_FILE}"
tenant:          ${TENANT_ID} (${TENANT_SLUG}) — ${TENANT_STATUS}
brand:           ${BRAND_ID} (${BRAND_CODE})
locations:       ${#LOCATION_CODES[@]} (${LOCATION_CODES[*]})
