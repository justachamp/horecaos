#!/usr/bin/env bash
#
# ADR 0055 phase 5 dev/test proving run.
#
# Proves, against a fresh local stack and entirely through the HTTP API (no
# fixture shortcuts for the tenant under test — see docs/local-fixtures.md's
# demo tenant, used only for contrast/debugging, never touched by this
# script), that a brand-new tenant can be:
#
#   1. Created via the control-plane API by a platform administrator.
#   2. Carried through ADR 0008's resumable onboarding workflow, including
#      real validator failures and real resumes — not a template that never
#      fails.
#   3. Activated (ADR 0027/0050).
#   4. Taken a real phone+OTP customer through menu -> cart -> quote ->
#      checkout -> CLICK payment -> operations approval -> preparation ->
#      completion -> an ISSUED fiscal document with OFD evidence, and a
#      payment projection that reads CAPTURED.
#
# See docs/runbooks/proving-run.md for what each phase proves, the expected
# evidence, and the full, honest list of dev-only accommodations this script
# needs — every one of them is also called out at the point it happens below,
# with a comment naming the gap.
#
# Precondition: a fresh stack. This script's own first phase runs
# `docker compose down -v && make up`, exactly as docs/local-fixtures.md
# documents for returning the stack to its first-start state. Local volumes
# are disposable; never run this against an environment holding data you
# need.
#
# Usage:
#   tools/proving-run
#
# Overridable (all optional, all local-loopback by default):
#   HORECAOS_API_URL, HORECAOS_KEYCLOAK_URL, HORECAOS_OPENBAO_URL,
#   HORECAOS_OPENBAO_TOKEN, HORECAOS_KEYCLOAK_REALM,
#   HORECAOS_PROVING_RUN_LOG (defaults to a timestamped file under /tmp)
#
# Idempotency: not required across runs. A fresh `docker compose down -v` is
# the documented precondition (phase 0 does this itself), exactly like
# docs/local-fixtures.md's own reset instructions.

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

API="${HORECAOS_API_URL:-http://localhost:8080}"
KC="${HORECAOS_KEYCLOAK_URL:-http://localhost:8081}"
KC_REALM="${HORECAOS_KEYCLOAK_REALM:-horecaos}"
KC_ADMIN_USER="${HORECAOS_KEYCLOAK_ADMIN:-admin}"
KC_ADMIN_PASSWORD="${HORECAOS_KEYCLOAK_ADMIN_PASSWORD:-admin}"
BAO_URL="${HORECAOS_OPENBAO_URL:-http://localhost:8200}"
BAO_TOKEN="${HORECAOS_OPENBAO_TOKEN:-horecaos-local-root}"
DB_SERVICE="platform-db"
DB_APP_USER="horecaos_app"
DB_APP_PASSWORD="horecaos_app"
DB_MIGRATOR_USER="horecaos_migrator"
DB_MIGRATOR_PASSWORD="horecaos_migrator"
DB_NAME="horecaos"

RUN_STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_FILE="${HORECAOS_PROVING_RUN_LOG:-/tmp/horecaos-proving-run-${RUN_STAMP}.log}"
: > "${LOG_FILE}"

# Distinct per invocation, so two proving runs against two stacks never
# collide on a slug, an email, or an OpenBao path.
RUN_SUFFIX="${RUN_STAMP}"
TENANT_SLUG="proving-run-${RUN_SUFFIX}"
OWNER_EMAIL="owner@${TENANT_SLUG}.local"
PLATFORM_ADMIN_USERNAME="proving-run-platform-admin-${RUN_SUFFIX}"
PLATFORM_ADMIN_PASSWORD="proving-run-$(uuidgen)"
OWNER_PASSWORD="proving-run-$(uuidgen)"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

# ---------------------------------------------------------------------------
# Small library
# ---------------------------------------------------------------------------

section() {
  echo | tee -a "${LOG_FILE}"
  echo "==================================================================" | tee -a "${LOG_FILE}"
  echo "== $1" | tee -a "${LOG_FILE}"
  echo "==================================================================" | tee -a "${LOG_FILE}"
}

log() { echo "-- $1" | tee -a "${LOG_FILE}"; }

evidence() { echo "   EVIDENCE: $1" | tee -a "${LOG_FILE}"; }

gap() { echo "   GAP: $1" | tee -a "${LOG_FILE}"; }

fail() {
  echo | tee -a "${LOG_FILE}"
  echo "!! FAILED: $1" | tee -a "${LOG_FILE}"
  exit 1
}

idemp() { uuidgen; }

# req METHOD URL EXPECTED_STATUS [curl-args...]
# Issues a request, fails loudly with the full response body on an
# unexpected status, and prints the body to stdout on success so callers can
# capture it with $(...).
req() {
  local method="$1" url="$2" expected="$3"
  shift 3
  local response status body
  response="$(curl -sS -w '\n%{http_code}' -X "${method}" "${url}" "$@")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [ "${status}" != "${expected}" ]; then
    {
      echo "!! ${method} ${url} -> HTTP ${status}, expected ${expected}"
      echo "!! Response body:"
      echo "${body}" | (jq . 2>/dev/null || cat)
    } | tee -a "${LOG_FILE}" >&2
    exit 1
  fi
  echo "${body}"
}

psql_app() {
  docker compose exec -T -e PGPASSWORD="${DB_APP_PASSWORD}" "${DB_SERVICE}" \
    psql -v ON_ERROR_STOP=1 -U "${DB_APP_USER}" -d "${DB_NAME}" "$@"
}

psql_migrator() {
  docker compose exec -T -e PGPASSWORD="${DB_MIGRATOR_PASSWORD}" "${DB_SERVICE}" \
    psql -v ON_ERROR_STOP=1 -U "${DB_MIGRATOR_USER}" -d "${DB_NAME}" "$@"
}

kc_admin_token() {
  curl -sf -X POST "${KC}/realms/master/protocol/openid-connect/token" \
    -d "client_id=admin-cli" -d "username=${KC_ADMIN_USER}" -d "password=${KC_ADMIN_PASSWORD}" \
    -d "grant_type=password" | jq -r .access_token
}

# ---------------------------------------------------------------------------
# Phase 0: fresh stack
# ---------------------------------------------------------------------------

section "Phase 0: fresh stack"

log "docker compose down -v (this project's volumes are disposable)"
docker compose down -v 2>&1 | tee -a "${LOG_FILE}"

log "make up (Postgres, Kafka, Keycloak, OpenBao, MinIO; asserts Keycloak service-account roles)"
make up 2>&1 | tee -a "${LOG_FILE}"
evidence "make up completed without error — Keycloak realm import and ADR 0009 service-account role assignment are themselves under test here"

# GAP (compose.yaml, fixed by this change — not Java, no mvnw verify needed):
# openbao-seed never seeded object_storage/platform/media-{access,secret}-key
# or data_encryption/platform/handover-pepper. Those are required only when
# HORECAOS_SECRETS_PROVIDER=openbao (docs/development.md's own documented way
# to exercise the OpenBao path instead of the "environment" provider
# default), and this proving run needs the OpenBao path for real: payments'
# SecretResolver has no "environment" fallback for a tenant-scoped merchant
# secret, so a real (fake-provider) CLICK payment cannot be proved without
# it. Fixed directly in compose.yaml's openbao-seed step; see its comment.
log "Seeding the .env used for HORECAOS_SECRETS_PROVIDER=openbao (docs/development.md's documented path)"
if [ ! -f .env ]; then
  cp .env.example .env
fi
set -a
# shellcheck disable=SC1091
source .env
set +a

section "Phase 1: identity bootstrap (Keycloak only, before the API starts)"

# GAP (Keycloak, worked around with local-dev-only scripts, not a Java
# change): horecaos-realm.json ships no realm users and horecaos-api is
# bearerOnly with directAccessGrantsEnabled=false — correctly, it is the
# resource server, not something anybody signs into. Nothing in the realm
# supports non-interactive (password-grant) token acquisition, which this
# script needs to drive the API headlessly the way a human would through
# Swagger UI's Authorize button. infra/keycloak/create-local-dev-client.sh
# creates a confidential, direct-grant-enabled client scoped to local/loopback
# only, mirroring create-local-web-client.sh's own guard.
log "Creating the local-dev password-grant Keycloak client (infra/keycloak/create-local-dev-client.sh)"
DEV_CLIENT_SECRET="$(./infra/keycloak/create-local-dev-client.sh)"
evidence "client horecaos-local-dev created/updated, direct grants enabled, loopback-only"

# GAP (Keycloak, same class): no platform-admin realm user exists on a fresh
# deployment either — ADR 0003 deliberately leaves who holds the role to each
# deployment. infra/keycloak/create-platform-admin.sh creates one and assigns
# the horecaos-api platform-admin client role directly (a normal, global,
# non-org-scoped role mapping — nothing ADR-0009-specific). It now prints the
# subject id on stdout (and only that; everything else it logs goes to
# stderr) instead of the username, which is exactly what Gap A's config
# bootstrap needs next.
log "Creating the platform-admin realm user (infra/keycloak/create-platform-admin.sh)"
ADMIN_SUBJECT="$(HORECAOS_PLATFORM_ADMIN_PASSWORD="${PLATFORM_ADMIN_PASSWORD}" \
  ./infra/keycloak/create-platform-admin.sh "${PLATFORM_ADMIN_USERNAME}" 2>>"${LOG_FILE}")"
[ -n "${ADMIN_SUBJECT}" ] || fail "create-platform-admin.sh did not print a subject id"
evidence "realm user ${PLATFORM_ADMIN_USERNAME} holds the horecaos-api platform-admin client role; subject=${ADMIN_SUBJECT}"

# GAP A, CLOSED (was: one direct SQL insert into iam.grants, the load-bearing
# gap of the whole run). PlatformAdminBootstrapReconciler — an
# ApplicationRunner, the same pattern RoleRegistrySynchronizer already uses —
# now reconciles horecaos.iam.bootstrap-platform-admins on every startup: it
# creates the PLATFORM-scope platform-admin grant for every subject listed,
# idempotently, and never revokes one config no longer names. Exporting the
# subject id here, before the API starts, is the whole fix — no SQL, no
# bespoke endpoint call, just the config a real deployment would set too.
export HORECAOS_IAM_BOOTSTRAP_PLATFORM_ADMINS="${ADMIN_SUBJECT}"
log "HORECAOS_IAM_BOOTSTRAP_PLATFORM_ADMINS=${ADMIN_SUBJECT} exported for the API's own startup (Gap A, closed)"

section "Phase 0: start the API"

# A stale `spring-boot:run` from an earlier session left bound to this port
# answers readiness checks (it is a healthy process) while talking to a
# database `down -v` just deleted — the exact failure this guard exists to
# turn into a clear message instead of a confusing mid-run SQL error.
API_PORT="$(printf '%s' "${API}" | sed -n 's#.*:\([0-9]\+\)$#\1#p')"
if [ -n "${API_PORT}" ] && lsof -i ":${API_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  fail "something is already listening on port ${API_PORT} (${API}) — likely a leftover 'mvnw spring-boot:run' from an earlier session, now talking to a database phase 0 just deleted. Stop it (check 'ps aux | grep spring-boot:run') and re-run."
fi

RUN_LOG_APP="/tmp/horecaos-proving-run-app-${RUN_SUFFIX}.log"
log "mvnw spring-boot:run -Dspring-boot.run.profiles=local (background, log: ${RUN_LOG_APP})"
nohup ./mvnw spring-boot:run -Dspring-boot.run.profiles=local > "${RUN_LOG_APP}" 2>&1 &
APP_PID=$!
log "app pid ${APP_PID}; waiting for readiness on ${API}/actuator/health/readiness"

READY=0
for _ in $(seq 1 90); do
  if curl -sf -o /dev/null "${API}/actuator/health/readiness"; then
    READY=1
    break
  fi
  if ! kill -0 "${APP_PID}" 2>/dev/null; then
    tail -n 80 "${RUN_LOG_APP}" | tee -a "${LOG_FILE}"
    fail "the application process exited before becoming ready; see ${RUN_LOG_APP}"
  fi
  sleep 5
done
[ "${READY}" = "1" ] || fail "the application never became ready within 450s; see ${RUN_LOG_APP}"
evidence "GET ${API}/actuator/health/readiness -> ready"

# ---------------------------------------------------------------------------
# Phase 1 (continued): acquire the platform-admin token; prove Gap A closed
# ---------------------------------------------------------------------------

kc_token() {
  local username="$1" password="$2" scope="$3"
  curl -sS -X POST "${KC}/realms/${KC_REALM}/protocol/openid-connect/token" \
    -d "client_id=horecaos-local-dev" -d "client_secret=${DEV_CLIENT_SECRET}" \
    -d "grant_type=password" -d "username=${username}" -d "password=${password}" \
    ${scope:+-d "scope=${scope}"} | jq -r .access_token
}

ADMIN_TOKEN="$(kc_token "${PLATFORM_ADMIN_USERNAME}" "${PLATFORM_ADMIN_PASSWORD}" "")"
[ -n "${ADMIN_TOKEN}" ] && [ "${ADMIN_TOKEN}" != "null" ] || fail "could not acquire a platform-admin token"
evidence "platform-admin token acquired for subject ${ADMIN_SUBJECT}"

# GAP A, PROVEN CLOSED LIVE (was: the load-bearing gap of the whole run — see
# docs/runbooks/proving-run.md for the full history). Creating a tenant needs
# TENANT_WRITE at PLATFORM scope, which nothing but a real PLATFORM-scope
# grant can satisfy; the bootstrap bypass only ever confers IAM_GRANT_MANAGE.
# If PlatformAdminBootstrapReconciler had not run, this would fail with the
# same 403 INSUFFICIENT_CAPABILITY the original proving run hit. Proving it
# here, before phase 2, is what makes every later phase's success evidence
# that the config bootstrap worked rather than an assumption — and it
# exercises the new front door itself (audit.web.PlatformGrantController)
# rather than only the config path.
GAP_A_PROOF_STATUS="$(curl -sS -o /dev/null -w '%{http_code}' -X POST "${API}/api/v1/control-plane/grants" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d '{"principalSubject":"gap-a-proof-subject","roleCode":"platform-support","reason":"proving run: Gap A closed"}')"
[ "${GAP_A_PROOF_STATUS}" = "200" ] || fail "Gap A regression: POST /control-plane/grants (a PLATFORM-scope grant) returned ${GAP_A_PROOF_STATUS}, not 200 — the config bootstrap did not take effect"
evidence "POST /control-plane/grants (PLATFORM scope) -> 200 (Gap A closed: config bootstrap + audit.web.PlatformGrantController, no SQL)"

# ---------------------------------------------------------------------------
# Phase 2a: the default onboarding template (Gap B, closed)
# ---------------------------------------------------------------------------

# GAP B, CLOSED (was: one direct SQL insert into tenant.onboarding_templates,
# the same class as Gap A). V0098 seeds the v1 platform default template as
# versioned reference data; OnboardingTemplateController exposes it
# read-only. Fetched here as evidence; deliberately NOT passed to the
# start-run call in phase 3 below — Gap B's other half is that omitting
# templateId there now resolves to this same template automatically.
TEMPLATE_JSON="$(req GET "${API}/api/v1/control-plane/onboarding-templates/default" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}")"
TEMPLATE_ID="$(echo "${TEMPLATE_JSON}" | jq -r .id)"
evidence "default onboarding template ${TEMPLATE_ID} (code=default, version=$(echo "${TEMPLATE_JSON}" | jq -r .version)) resolved via GET .../onboarding-templates/default (Gap B closed: V0098 + OnboardingTemplateController, no SQL)"

# ---------------------------------------------------------------------------
# Phase 2: tenant, brand, location (platform-admin, control-plane API)
# ---------------------------------------------------------------------------

section "Phase 2: tenant creation"

TENANT_JSON="$(req POST "${API}/api/v1/control-plane/tenants" 201 \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d "$(jq -n --arg slug "${TENANT_SLUG}" '{
        slug: $slug,
        legalName: "Proving Run Foods LLC",
        displayName: "Proving Run Tenant",
        defaultCurrency: "UZS",
        defaultTimezone: "Asia/Tashkent",
        customerIdentityMode: "TENANT_SHARED"
      }')")"
TENANT_ID="$(echo "${TENANT_JSON}" | jq -r .id)"
evidence "tenant ${TENANT_ID} (slug=${TENANT_SLUG}) created; status=$(echo "${TENANT_JSON}" | jq -r .status)"

BRAND_JSON="$(req POST "${API}/api/v1/control-plane/tenants/${TENANT_ID}/brands" 201 \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d '{"code":"MAIN","slug":"main-brand","displayName":"Proving Run Brand"}')"
BRAND_ID="$(echo "${BRAND_JSON}" | jq -r .id)"
evidence "brand ${BRAND_ID} created"

LOCATION_JSON="$(req POST "${API}/api/v1/control-plane/tenants/${TENANT_ID}/brands/${BRAND_ID}/locations" 201 \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d '{"code":"MAIN01","slug":"main-location","displayName":"Proving Run Location","timezone":"Asia/Tashkent"}')"
LOCATION_ID="$(echo "${LOCATION_JSON}" | jq -r .id)"
evidence "location ${LOCATION_ID} created"

req PUT "${API}/api/v1/control-plane/tenants/${TENANT_ID}/brands/${BRAND_ID}/locations/${LOCATION_ID}/place" 200 \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d '{"addressLine":"12 Amir Temur Street","district":"Yunusabad","city":"Tashkent","contactPhone":"+998712000001","latitude":41.3350,"longitude":69.2880,"coordinateSource":"MERCHANT_PIN"}' \
  > /dev/null
evidence "location place recorded (Tashkent, 41.3350,69.2880)"

# GAP C, CLOSED (was: confirmed live, worked around by having platform-admin
# do this instead of the tenant owner). TenantAccessPolicy.requireTenantManagement
# used to accept only the global platform-admin realm role or an org-nested
# Keycloak client role ("tenant-owner"/"tenant-admin") that nothing in this
# codebase ever assigned — Keycloak 26.7's Organizations Admin REST API has
# no organization-scoped role sub-resource at all
# (OrganizationProvisioner's own class javadoc). It now resolves through the
# same AuthorizationService/iam.grants every other endpoint uses, with the
# exact capability and scope the calling controller's own @RequiresCapability
# already declares. Proven live below, right after the owner signs in: the
# owner creates a second brand and location themselves — the exact proving-run
# scenario Gap C names.

# ---------------------------------------------------------------------------
# Phase 3: onboarding run — first pass, expect a real failure
# ---------------------------------------------------------------------------

section "Phase 3: start the onboarding run"

# templateId deliberately omitted: Gap B's other half is that the control
# plane now resolves the platform's current default template on its own
# (OnboardingController.start), the same one fetched as TEMPLATE_ID above.
RUN_JSON="$(req POST "${API}/api/v1/control-plane/tenants/${TENANT_ID}/onboarding-runs" 200 \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d "$(jq -n --arg email "${OWNER_EMAIL}" '{ownerEmail:$email}')")"
RUN_ID="$(echo "${RUN_JSON}" | jq -r .runId)"
evidence "onboarding run ${RUN_ID} started for tenant ${TENANT_ID}, owner email ${OWNER_EMAIL} (templateId omitted; resolved the default automatically)"

run_view() { req GET "${API}/api/v1/control-plane/tenants/${TENANT_ID}/onboarding-runs/${RUN_ID}" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}"; }

# Waits (poll every 4s) until the run reaches one of the given top-level
# statuses, or until timeout. The scheduler's own cadence is a 10s initial
# delay then a 5s tick (horecaos.onboarding.scheduler.*), and a step that
# calls StepResult.failed(...) — every validator this run exercises — goes
# straight to FAILED on its first attempt, no backoff; only StepResult.retry
# results back off exponentially. 90s covers several ticks with margin.
wait_for_run_status() {
  local wanted="$1" timeout="${2:-90}" elapsed=0 status view
  while [ "${elapsed}" -lt "${timeout}" ]; do
    view="$(run_view)"
    status="$(echo "${view}" | jq -r .run.status)"
    if echo "${wanted}" | tr ',' '\n' | grep -qx "${status}"; then
      echo "${view}"
      return 0
    fi
    sleep 4
    elapsed=$((elapsed + 4))
  done
  echo "${view}" | tee -a "${LOG_FILE}"
  fail "onboarding run ${RUN_ID} did not reach status [${wanted}] within ${timeout}s (last seen: ${status})"
}

log "Waiting for step 2 (TENANT_OWNER_LINK_OR_INVITE) to complete, so the owner exists"
OWNER_WAIT_ELAPSED=0
OWNER_SUBJECT=""
while [ "${OWNER_WAIT_ELAPSED}" -lt 60 ]; do
  VIEW="$(run_view)"
  OWNER_STEP="$(echo "${VIEW}" | jq -r '.steps[] | select(.stepKey=="TENANT_OWNER_LINK_OR_INVITE")')"
  if [ "$(echo "${OWNER_STEP}" | jq -r .status)" = "COMPLETED" ]; then
    OWNER_SUBJECT="$(echo "${OWNER_STEP}" | jq -r .externalReference)"
    break
  fi
  sleep 4
  OWNER_WAIT_ELAPSED=$((OWNER_WAIT_ELAPSED + 4))
done
[ -n "${OWNER_SUBJECT}" ] && [ "${OWNER_SUBJECT}" != "null" ] || fail "TENANT_OWNER_LINK_OR_INVITE never completed"
evidence "owner Keycloak subject ${OWNER_SUBJECT} linked (ADR 0009 organization membership, real Keycloak Admin API call)"

# GAP D, closed, proven live: DEFAULT_CONFIGURATION_APPLY (step 3, right
# after the owner link) applies the template's default_configuration —
# RESTAURANT_APPROVAL, fetched as evidence back in phase 2a — as the
# tenant's ordering.acceptance policy, with zero manual policy work from
# this script. Waited for here, before touching payment/catalog, so its
# completion is evidence rather than an assumption phase 9 later relies on.
log "Waiting for step 3 (DEFAULT_CONFIGURATION_APPLY) to complete"
DEFAULT_CONFIG_WAIT_ELAPSED=0
DEFAULT_CONFIG_APPLIED=""
while [ "${DEFAULT_CONFIG_WAIT_ELAPSED}" -lt 60 ]; do
  VIEW="$(run_view)"
  DEFAULT_CONFIG_STEP="$(echo "${VIEW}" | jq -r '.steps[] | select(.stepKey=="DEFAULT_CONFIGURATION_APPLY")')"
  if [ "$(echo "${DEFAULT_CONFIG_STEP}" | jq -r .status)" = "COMPLETED" ]; then
    DEFAULT_CONFIG_APPLIED="true"
    break
  fi
  sleep 4
  DEFAULT_CONFIG_WAIT_ELAPSED=$((DEFAULT_CONFIG_WAIT_ELAPSED + 4))
done
[ "${DEFAULT_CONFIG_APPLIED}" = "true" ] || fail "DEFAULT_CONFIGURATION_APPLY never completed"

ACCEPTANCE_POLICY_JSON="$(req GET "${API}/api/v1/control-plane/tenants/${TENANT_ID}/order-acceptance-policy" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}")"
ACCEPTANCE_MODE="$(echo "${ACCEPTANCE_POLICY_JSON}" | jq -r .mode)"
[ "${ACCEPTANCE_MODE}" = "RESTAURANT_APPROVAL" ] || fail "Gap D regression: tenant ${TENANT_ID} resolves ordering.acceptance = ${ACCEPTANCE_MODE}, not RESTAURANT_APPROVAL — the template default did not apply"
evidence "GET .../order-acceptance-policy -> RESTAURANT_APPROVAL (Gap D closed: V0098 default_configuration + DefaultConfigurationApply + PolicyAuthor, no SQL), isPlatformDefault=$(echo "${ACCEPTANCE_POLICY_JSON}" | jq -r .isPlatformDefault)"

# GAP E, CLOSED (was: an Admin-API PATCH of firstName/lastName here, worked
# around because KeycloakOrganizationProvisioner.ensureMembership created the
# invited owner with only username/email — deliberately, ADR 0009's own
# membership contract — and Keycloak 26's declarative User Profile refuses
# ANY password-grant login for an account missing either, with the
# misleading invalid_grant "Account is not fully set up"
# (keycloak/keycloak#36108, still present in the pinned 26.7.0). Fixed at
# both ends: ensureMembership now always sets honest placeholder name
# attributes (PENDING_FIRST_NAME/PENDING_LAST_NAME) so a fresh invite never
# creates a nameless account in the first place, and
# infra/keycloak/realm/horecaos-realm.json's declarative user profile no
# longer requires firstName/lastName at all for local dev, so an account
# missing them (a fixture, an older row) still authenticates. Only the
# password reset remains — a real owner would set theirs through Keycloak's
# own invitation/reset flow, and a script has to stand in for that click.
log "Setting the owner's password (the one Keycloak step with no HTTP equivalent — a real owner does this through Keycloak's own reset flow)"
KC_ADMIN_TOKEN="$(kc_admin_token)"
curl -sf -o /dev/null -X PUT "${KC}/admin/realms/${KC_REALM}/users/${OWNER_SUBJECT}/reset-password" \
  -H "Authorization: Bearer ${KC_ADMIN_TOKEN}" -H "Content-Type: application/json" \
  -d "$(jq -n --arg p "${OWNER_PASSWORD}" '{type:"password", value:$p, temporary:false}')"
evidence "owner password set (Gap E closed: no profile PATCH needed — ensureMembership sets honest placeholder names, and the local realm's profile no longer requires them)"

OWNER_TOKEN="$(kc_token "${OWNER_EMAIL}" "${OWNER_PASSWORD}" "organization:${TENANT_SLUG}")"
[ -n "${OWNER_TOKEN}" ] && [ "${OWNER_TOKEN}" != "null" ] || fail "could not acquire an owner token"
evidence "owner signed in over HTTP with organization:${TENANT_SLUG} scope"

# GAP C, CLOSED — proven live further down, right after the tenant reaches
# ACTIVE (end of Phase 6). It used to run here, but every onboarding
# readiness validator (PAYMENT_CONFIGURATION_VALIDATE, then
# CATALOG_READINESS_VALIDATE, and by the same logic MEDIA_READINESS_VALIDATE
# and FRONTEND_DOMAIN_VALIDATE too) checks every brand and location the
# tenant has, so a throwaway proof brand created mid-onboarding has to be
# fully configured — payments, catalog, media, domain — just to let an
# unrelated run finish, which is not what this gap is about and not
# something a real second brand would need on day one. Proving the grant
# works once the tenant is already active demonstrates exactly the same
# thing (an ordinary tenant-owner grant, no Keycloak org-nested role)
# without dragging onboarding readiness into it.

log "Waiting for the run to reach READY or a FAILED step"
VIEW="$(wait_for_run_status "READY,FAILED" 90)"
echo "${VIEW}" | jq . >> "${LOG_FILE}"
FAILED_STEP="$(echo "${VIEW}" | jq -r '[.steps[] | select(.status=="FAILED")][0].stepKey // empty')"
