ENV_CODE="click-${TENANT_SLUG}-sandbox"
log "Seeding the platform-owned CLICK provider environment (${ENV_CODE}) — no tenant-facing write endpoint exists for this table by design (ADR 0026)"
psql_migrator <<SQL
INSERT INTO integration.provider_environments
    (code, provider_category, provider_type, base_url, is_production, egress_allowlist, notes)
VALUES ('${ENV_CODE}', 'PAYMENT', 'CLICK', 'http://localhost:18089', false, 'localhost',
        'tools/proving-run: local dev only, points at FakeClickHttpProvider')
ON CONFLICT (code) DO UPDATE SET base_url = EXCLUDED.base_url;
SQL

# The secret VALUE, not just its reference format, matters: FakeClickHttpProvider
# validates every merchant-API call's Auth header against
# FakeClickProviderConfiguration's own configured secret
# (horecaos.fake-providers.click.secret), whose default is exactly this
# string — the fake does not read OpenBao itself, so the resolved secret and
# the fake's own default must agree by construction, mirroring
# tools/seed-payments' own comment on this. Any other value authenticates as
# nothing and every provider call comes back "rejected the cached
# credential", which is indistinguishable from a real secret mismatch.
SECRET_REFERENCE="horecaos:local:provider_payment:${TENANT_SLUG}:click"
log "Writing the fake CLICK secret to OpenBao at ${SECRET_REFERENCE}"
curl -sf -X POST -H "X-Vault-Token: ${BAO_TOKEN}" -H "Content-Type: application/json" \
  -d '{"data":{"value":"local-fixture-click-secret-key-not-a-real-credential"}}' \
  "${BAO_URL}/v1/horecaos/data/local/provider_payment/${TENANT_SLUG}/click" > /dev/null
