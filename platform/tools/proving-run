log "Seeding an ordering.acceptance=RESTAURANT_APPROVAL policy (no authoring endpoint exists — see Gap D)"
ACCEPTANCE_DOC='{"mode":"RESTAURANT_APPROVAL","approvalChannel":"HORECAOS_OPERATIONS","approvalTimeoutSeconds":600,"timeoutAction":"AUTO_REJECT","rejectionReasonRequired":false,"notifyCustomerWhilePending":true}'
ACCEPTANCE_HASH="$(printf '%s' "${ACCEPTANCE_DOC}" | shasum -a 256 | awk '{print $1}')"
ACCEPTANCE_POLICY_ID="$(uuidgen | tr 'A-Z' 'a-z')"
psql_migrator <<SQL
INSERT INTO tenant.policies
    (id, key_code, scope_type, tenant_id, brand_id, location_id, version, status,
     document, document_hash, valid_from, created_by, approved_by)
VALUES ('${ACCEPTANCE_POLICY_ID}', 'ordering.acceptance', 'TENANT', '${TENANT_ID}', NULL, NULL, 1, 'ACTIVE',
        '${ACCEPTANCE_DOC}'::jsonb, '${ACCEPTANCE_HASH}', now(),
        'tools/proving-run bootstrap', 'tools/proving-run bootstrap');
INSERT INTO tenant.policy_current (key_code, scope_type, tenant_id, brand_id, location_id, policy_id, policy_version, activated_by)
VALUES ('ordering.acceptance', 'TENANT', '${TENANT_ID}', NULL, NULL, '${ACCEPTANCE_POLICY_ID}', 1, 'tools/proving-run bootstrap');
SQL
evidence "tenant ${TENANT_ID} now resolves ordering.acceptance = RESTAURANT_APPROVAL"

# ---------------------------------------------------------------------------
# Phase 3: onboarding run — first pass, expect a real failure
# ---------------------------------------------------------------------------

section "Phase 3: start the onboarding run"

RUN_JSON="$(req POST "${API}/api/v1/control-plane/tenants/${TENANT_ID}/onboarding-runs" 200 \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d "$(jq -n --arg t "${TEMPLATE_ID}" --arg email "${OWNER_EMAIL}" \
        '{templateId:$t, templateVersion:1, ownerEmail:$email}')")"
RUN_ID="$(echo "${RUN_JSON}" | jq -r .runId)"
evidence "onboarding run ${RUN_ID} started for tenant ${TENANT_ID}, owner email ${OWNER_EMAIL}"

run_view() { req GET "${API}/api/v1/control-plane/tenants/${TENANT_ID}/onboarding-runs/${RUN_ID}" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}"; }

# Waits (poll every 4s) until the run reaches one of the given top-level
# statuses, or until timeout. The scheduler's own cadence is a 10s initial
# delay then a 5s tick (horecaos.onboarding.scheduler.*), and a step that
# calls StepResult.failed(...) — every validator this run exercises — goes
# straight to FAILED on its first attempt, no backoff; only StepResult.retry
# results back off exponentially. 90s covers several ticks with margin.
wait_for_run_status() {
  local wanted="$1" timeout="${2:-90}" elapsed=0 status view
  while [ "${elapsed}" -lt "${timeout}" ]; do
    view="$(run_view)"
    status="$(echo "${view}" | jq -r .run.status)"
    if echo "${wanted}" | tr ',' '\n' | grep -qx "${status}"; then
      echo "${view}"
      return 0
    fi
    sleep 4
    elapsed=$((elapsed + 4))
  done
  echo "${view}" | tee -a "${LOG_FILE}"
  fail "onboarding run ${RUN_ID} did not reach status [${wanted}] within ${timeout}s (last seen: ${status})"
}

log "Waiting for step 2 (TENANT_OWNER_LINK_OR_INVITE) to complete, so the owner exists"
OWNER_WAIT_ELAPSED=0
OWNER_SUBJECT=""
while [ "${OWNER_WAIT_ELAPSED}" -lt 60 ]; do
  VIEW="$(run_view)"
  OWNER_STEP="$(echo "${VIEW}" | jq -r '.steps[] | select(.stepKey=="TENANT_OWNER_LINK_OR_INVITE")')"
  if [ "$(echo "${OWNER_STEP}" | jq -r .status)" = "COMPLETED" ]; then
    OWNER_SUBJECT="$(echo "${OWNER_STEP}" | jq -r .externalReference)"
    break
  fi
  sleep 4
  OWNER_WAIT_ELAPSED=$((OWNER_WAIT_ELAPSED + 4))
done
[ -n "${OWNER_SUBJECT}" ] && [ "${OWNER_SUBJECT}" != "null" ] || fail "TENANT_OWNER_LINK_OR_INVITE never completed"
evidence "owner Keycloak subject ${OWNER_SUBJECT} linked (ADR 0009 organization membership, real Keycloak Admin API call)"

# GAP (Keycloak behavior, worked around in this script — not a code change,
# and arguably not even a HorecaOS gap): KeycloakOrganizationProvisioner
# creates the invited owner with only username/email (deliberately — ADR
# 0009's own membership contract). Keycloak 26's declarative User Profile
# then refuses ANY password-grant login for an account missing firstName or
# lastName with the misleading invalid_grant "Account is not fully set up" —
# no exception, no realm setting names it (confirmed by reproducing it
# against a stock realm with DEBUG logging: this is
# https://github.com/keycloak/keycloak/issues/36108, a known Keycloak 26.0.7+
# regression). A real owner hitting this in a browser just sees Keycloak's
# own "complete your profile" required-action screen and fills it in; a
# script has no browser, so it does the Keycloak Admin API equivalent
# directly, plus setting the password a real owner would set through
# Keycloak's own invitation/reset flow.
log "Patching the owner's Keycloak profile and setting a password (Keycloak 26 User Profile quirk — see Gap E in the runbook; a browser flow shows this as a normal 'complete your profile' step)"
KC_ADMIN_TOKEN="$(kc_admin_token)"
curl -sf -o /dev/null -X PUT "${KC}/admin/realms/${KC_REALM}/users/${OWNER_SUBJECT}" \
  -H "Authorization: Bearer ${KC_ADMIN_TOKEN}" -H "Content-Type: application/json" \
  -d '{"firstName":"Proving Run","lastName":"Owner","enabled":true,"emailVerified":true}'
curl -sf -o /dev/null -X PUT "${KC}/admin/realms/${KC_REALM}/users/${OWNER_SUBJECT}/reset-password" \
  -H "Authorization: Bearer ${KC_ADMIN_TOKEN}" -H "Content-Type: application/json" \
  -d "$(jq -n --arg p "${OWNER_PASSWORD}" '{type:"password", value:$p, temporary:false}')"
evidence "owner profile completed and password set"

OWNER_TOKEN="$(kc_token "${OWNER_EMAIL}" "${OWNER_PASSWORD}" "organization:${TENANT_SLUG}")"
