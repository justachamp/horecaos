  -d "$(jq -n --arg l "${LOCATION_ID}" '{locationId:$l, channel:"STOREFRONT", fulfillmentMode:"PICKUP"}')")"
CART_ID="$(echo "${CART_JSON}" | jq -r .cartId)"

LINE_JSON="$(req PUT "${STOREFRONT}/carts/${CART_ID}/lines/line1" 200 \
  -H "Authorization: Bearer ${CUSTOMER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" -H "If-Match: 1" \
  -d "$(jq -n --arg v "${VARIANT_ID}" '{variantId:$v, quantity:2}')")"
CART_VERSION="$(echo "${LINE_JSON}" | jq -r .version)"

PRICE_JSON="$(req POST "${STOREFRONT}/carts/${CART_ID}/pricing" 200 \
  -H "Authorization: Bearer ${CUSTOMER_TOKEN}" -H "Idempotency-Key: $(idemp)" -H "If-Match: ${CART_VERSION}")"
QUOTE_ID="$(echo "${PRICE_JSON}" | jq -r .quoteId)"
CONTEXT_HASH="$(echo "${PRICE_JSON}" | jq -r .contextHash)"
evidence "priced quote ${QUOTE_ID}: $(echo "${PRICE_JSON}" | jq -c '{subtotalMinor,taxMinor,totalMinor,currency}')"

CHECKOUT_JSON="$(req POST "${STOREFRONT}/checkouts" 200 \
  -H "Authorization: Bearer ${CUSTOMER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d "$(jq -n --arg c "${CART_ID}" --arg v "${CART_VERSION}" --arg q "${QUOTE_ID}" --arg h "${CONTEXT_HASH}" \
        '{cartId:$c, cartVersion:($v|tonumber), quoteId:$q, contextHash:$h, paymentMethodCode:"CLICK"}')")"
ORDER_ID="$(echo "${CHECKOUT_JSON}" | jq -r .orderId)"
evidence "order ${ORDER_ID} (public number $(echo "${CHECKOUT_JSON}" | jq -r .publicOrderNumber)) created: status=$(echo "${CHECKOUT_JSON}" | jq -r .status)"

# ---------------------------------------------------------------------------
# Phase 8: payment (real payment session + fake-provider capture)
# ---------------------------------------------------------------------------

section "Phase 8: payment"

PAY_SESSION_JSON="$(req POST "${STOREFRONT}/orders/${ORDER_ID}/payment-sessions" 200 \
  -H "Authorization: Bearer ${CUSTOMER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" -d '{}')"
ATTEMPT_ID="$(echo "${PAY_SESSION_JSON}" | jq -r .attemptId)"
evidence "payment attempt ${ATTEMPT_ID} opened: $(echo "${PAY_SESSION_JSON}" | jq -c '{provider,presentation,amountMinor,currency}')"

# tools/pay-fake-click's own mechanics, pointed at THIS tenant/order rather
# than the fixture tenant — the same real DevFakeClickPaymentController
# endpoint (local profile only), which drives the real
# FakeCustomerPaymentService -> ClickCallbackProcessor path a genuine Click
# webhook would take.
FAKE_PAY_JSON="$(req POST "${API}/dev/fake-providers/click/tenants/${TENANT_ID}/orders/${ORDER_ID}/pay" 200)"
evidence "fake CLICK customer paid: $(echo "${FAKE_PAY_JSON}" | jq -c .)"

log "Waiting for the order to reach AWAITING_APPROVAL (RESTAURANT_APPROVAL policy) after capture"
ORDER_STATUS=""
for _ in $(seq 1 15); do
  ORDER_STATUS="$(req GET "${STOREFRONT}/orders/${ORDER_ID}" 200 -H "Authorization: Bearer ${CUSTOMER_TOKEN}" | jq -r .status)"
  [ "${ORDER_STATUS}" = "AWAITING_APPROVAL" ] && break
  sleep 2
done
[ "${ORDER_STATUS}" = "AWAITING_APPROVAL" ] || fail "order ${ORDER_ID} did not reach AWAITING_APPROVAL after payment capture (status: ${ORDER_STATUS})"
evidence "order ${ORDER_ID} status: AWAITING_APPROVAL (RESTAURANT_APPROVAL policy honored)"

# ---------------------------------------------------------------------------
# Phase 9: operations — approve, advance, complete (as the owner)
# ---------------------------------------------------------------------------

section "Phase 9: operations approval and fulfilment"

OPS="${API}/api/v1/tenants/${TENANT_ID}/brands/${BRAND_ID}/locations/${LOCATION_ID}/orders"

APPROVE_JSON="$(req POST "${OPS}/${ORDER_ID}/approval-decisions" 200 \
  -H "Authorization: Bearer ${OWNER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" \
  -d '{"decisionId":"proving-run-approve-1","action":"APPROVE","reasonCode":"PROVING_RUN_APPROVED"}')"
ORDER_VERSION="$(echo "${APPROVE_JSON}" | jq -r .version)"
evidence "order approved by ${OWNER_EMAIL} (ORDER_APPROVE @ LOCATION, via the tenant-owner bundle): status=$(echo "${APPROVE_JSON}" | jq -r .status)"

PREP_JSON="$(req POST "${OPS}/${ORDER_ID}/state-actions" 200 \
  -H "Authorization: Bearer ${OWNER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" -H "If-Match: ${ORDER_VERSION}" \
  -d '{"targetStatus":"PREPARING","reasonCode":"PROVING_RUN_ADVANCE"}')"
ORDER_VERSION="$(echo "${PREP_JSON}" | jq -r .version)"

READY_JSON="$(req POST "${OPS}/${ORDER_ID}/state-actions" 200 \
  -H "Authorization: Bearer ${OWNER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" -H "If-Match: ${ORDER_VERSION}" \
  -d '{"targetStatus":"READY","reasonCode":"PROVING_RUN_ADVANCE"}')"
ORDER_VERSION="$(echo "${READY_JSON}" | jq -r .version)"
evidence "order advanced PREPARING -> READY"

COMPLETE_JSON="$(req POST "${OPS}/${ORDER_ID}/completion" 200 \
  -H "Authorization: Bearer ${OWNER_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" -H "If-Match: ${ORDER_VERSION}" \
  -d '{}')"
ORDER_FINAL_STATUS="$(echo "${COMPLETE_JSON}" | jq -r .status)"
[ "${ORDER_FINAL_STATUS}" = "COMPLETED" ] || fail "order did not reach COMPLETED: ${COMPLETE_JSON}"
evidence "order ${ORDER_ID} COMPLETED"

# ---------------------------------------------------------------------------
# Phase 10: fiscal and payment evidence
# ---------------------------------------------------------------------------

section "Phase 10: fiscal and payment evidence"

log "Waiting for the fiscal obligation sweeper to open a document (horecaos.fiscal.obligation-opener: 20s initial delay, 1m interval)"
DOC_JSON="[]"
for _ in $(seq 1 20); do
  DOC_JSON="$(req GET "${API}/api/v1/tenants/${TENANT_ID}/fiscal/orders/${ORDER_ID}/documents" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}")"
  [ "$(echo "${DOC_JSON}" | jq 'length')" -gt 0 ] && break
  sleep 5
done
[ "$(echo "${DOC_JSON}" | jq 'length')" -gt 0 ] || fail "no fiscal document was ever opened for order ${ORDER_ID}"
DOC_ID="$(echo "${DOC_JSON}" | jq -r '.[0].documentId')"
evidence "fiscal document ${DOC_ID} opened: $(echo "${DOC_JSON}" | jq -c '.[0] | {status,reasonCode,providerType}')"

log "Waiting for the submission sweeper (horecaos.fiscal.obligation-opener: 40s initial delay, 1m interval), then retrying manually if needed"
DOC_STATUS=""
DOC_VERSION=""
for _ in $(seq 1 24); do
  DOC_JSON="$(req GET "${API}/api/v1/tenants/${TENANT_ID}/fiscal/orders/${ORDER_ID}/documents" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}")"
  DOC_STATUS="$(echo "${DOC_JSON}" | jq -r '.[0].status')"
  DOC_VERSION="$(echo "${DOC_JSON}" | jq -r '.[0].version')"
  [ "${DOC_STATUS}" = "ISSUED" ] && break
  sleep 5
done

if [ "${DOC_STATUS}" != "ISSUED" ] && [ "${DOC_STATUS}" = "SUBMITTED" ]; then
  # The automatic sweep only claims PENDING rows; a document already
  # SUBMITTED is not re-claimed on a timer. FISCAL_DOCUMENT_RESOLVE's manual
  # retry (the same one an operator would use from the fiscal worklist) is
  # the front-door way to push it again rather than waiting indefinitely.
  log "Document is SUBMITTED, not yet ISSUED; calling the manual retry endpoint once (FISCAL_DOCUMENT_RESOLVE)"
  RETRY_JSON="$(req POST "${API}/api/v1/tenants/${TENANT_ID}/fiscal/documents/${DOC_ID}/retries" 200 \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" -H "Idempotency-Key: $(idemp)" -H "If-Match: ${DOC_VERSION}" \
    -d '{"reason":"proving run: manual retry after the automatic submission sweep"}')"
  log "retry outcome: $(echo "${RETRY_JSON}" | jq -r .outcome)"
  DOC_JSON="$(req GET "${API}/api/v1/tenants/${TENANT_ID}/fiscal/orders/${ORDER_ID}/documents" 200 -H "Authorization: Bearer ${ADMIN_TOKEN}")"
  DOC_STATUS="$(echo "${DOC_JSON}" | jq -r '.[0].status')"
fi

if [ "${DOC_STATUS}" = "ISSUED" ]; then
  HAS_EVIDENCE="$(echo "${DOC_JSON}" | jq -r '.[0].hasEvidence')"
  evidence "fiscal document ${DOC_ID} ISSUED, hasEvidence=${HAS_EVIDENCE} (reasonCode=$(echo "${DOC_JSON}" | jq -r '.[0].reasonCode'))"
else
  gap "fiscal document ${DOC_ID} did not reach ISSUED within this run's wait budget (status: ${DOC_STATUS}). This has been observed to resolve with one more manual retry a short time later — see docs/runbooks/proving-run.md for the exact mechanics (ClickFiscalAdapter.capturedPaymentId's live status_by_mti fallback, and the merchant binding's secret VALUE, not just its reference, must equal FakeClickProviderConfiguration's own default for the fake provider's Auth check to pass)."
fi

# Payment projection: no HTTP endpoint reads a payment attempt's own status
# (PAYMENT_READ is declared in the capability catalogue but no controller in
# this codebase exposes a query surface for it — a real, separate finding).
# Read directly as evidence, not as a workaround for a missing write path:
# nothing here is being changed, only observed.
gap "No HTTP endpoint exposes a payment attempt's own status (PAYMENT_READ capability is declared with no controller using it). Payment projection evidence below is read directly from payments.payment_attempts for verification purposes only."
PAYMENT_ROW="$(psql_app -t -A -F'|' <<SQL
SELECT status, provider_type, external_document_id
  FROM payments.payment_attempts
 WHERE id = '${ATTEMPT_ID}';
SQL
)"
evidence "payments.payment_attempts[${ATTEMPT_ID}] = ${PAYMENT_ROW} (status|provider_type|external_document_id)"
echo "${PAYMENT_ROW}" | grep -q '^CAPTURED|' || fail "payment attempt ${ATTEMPT_ID} is not CAPTURED: ${PAYMENT_ROW}"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

section "Summary"

cat <<SUMMARY | tee -a "${LOG_FILE}"
tenant:          ${TENANT_ID} (${TENANT_SLUG}) — ACTIVE
brand/location:  ${BRAND_ID} / ${LOCATION_ID}
onboarding run:  ${RUN_ID} — READY, activated
owner:           ${OWNER_EMAIL} (subject ${OWNER_SUBJECT})
legal entity:    ${LEGAL_ENTITY_ID}
merchant binding: ${MB_ID} (CLICK, ACTIVE)
catalog:         ${CATALOG_ID}, publication PUBLISHED
order:           ${ORDER_ID} — COMPLETED
payment attempt: ${ATTEMPT_ID} — CAPTURED
fiscal document: ${DOC_ID} — ${DOC_STATUS}

Full log: ${LOG_FILE}
App log:  ${RUN_LOG_APP}
SUMMARY

log "Proving run complete."
