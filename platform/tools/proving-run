#!/usr/bin/env bash
#
# ADR 0055 phase 5 dev/test proving run.
#
# Proves, against a fresh local stack and entirely through the HTTP API (no
# fixture shortcuts for the tenant under test — see docs/local-fixtures.md's
# demo tenant, used only for contrast/debugging, never touched by this
# script), that a brand-new tenant can be:
#
#   1. Created via the control-plane API by a platform administrator.
#   2. Carried through ADR 0008's resumable onboarding workflow, including
#      real validator failures and real resumes — not a template that never
#      fails.
#   3. Activated (ADR 0027/0050).
#   4. Taken a real phone+OTP customer through menu -> cart -> quote ->
#      checkout -> CLICK payment -> operations approval -> preparation ->
#      completion -> an ISSUED fiscal document with OFD evidence, and a
#      payment projection that reads CAPTURED.
#
# See docs/runbooks/proving-run.md for what each phase proves, the expected
# evidence, and the full, honest list of dev-only accommodations this script
# needs — every one of them is also called out at the point it happens below,
# with a comment naming the gap.
#
# Precondition: a fresh stack. This script's own first phase runs
# `docker compose down -v && make up`, exactly as docs/local-fixtures.md
# documents for returning the stack to its first-start state. Local volumes
# are disposable; never run this against an environment holding data you
# need.
#
# Usage:
#   tools/proving-run
#
# Overridable (all optional, all local-loopback by default):
#   HORECAOS_API_URL, HORECAOS_KEYCLOAK_URL, HORECAOS_OPENBAO_URL,
#   HORECAOS_OPENBAO_TOKEN, HORECAOS_KEYCLOAK_REALM,
#   HORECAOS_PROVING_RUN_LOG (defaults to a timestamped file under /tmp)
#
# Idempotency: not required across runs. A fresh `docker compose down -v` is
# the documented precondition (phase 0 does this itself), exactly like
# docs/local-fixtures.md's own reset instructions.

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

API="${HORECAOS_API_URL:-http://localhost:8080}"
KC="${HORECAOS_KEYCLOAK_URL:-http://localhost:8081}"
KC_REALM="${HORECAOS_KEYCLOAK_REALM:-horecaos}"
KC_ADMIN_USER="${HORECAOS_KEYCLOAK_ADMIN:-admin}"
KC_ADMIN_PASSWORD="${HORECAOS_KEYCLOAK_ADMIN_PASSWORD:-admin}"
BAO_URL="${HORECAOS_OPENBAO_URL:-http://localhost:8200}"
BAO_TOKEN="${HORECAOS_OPENBAO_TOKEN:-horecaos-local-root}"
DB_SERVICE="platform-db"
DB_APP_USER="horecaos_app"
DB_APP_PASSWORD="horecaos_app"
DB_MIGRATOR_USER="horecaos_migrator"
DB_MIGRATOR_PASSWORD="horecaos_migrator"
DB_NAME="horecaos"

RUN_STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_FILE="${HORECAOS_PROVING_RUN_LOG:-/tmp/horecaos-proving-run-${RUN_STAMP}.log}"
: > "${LOG_FILE}"

# Distinct per invocation, so two proving runs against two stacks never
# collide on a slug, an email, or an OpenBao path.
RUN_SUFFIX="${RUN_STAMP}"
TENANT_SLUG="proving-run-${RUN_SUFFIX}"
OWNER_EMAIL="owner@${TENANT_SLUG}.local"
PLATFORM_ADMIN_USERNAME="proving-run-platform-admin-${RUN_SUFFIX}"
PLATFORM_ADMIN_PASSWORD="proving-run-$(uuidgen)"
OWNER_PASSWORD="proving-run-$(uuidgen)"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

# ---------------------------------------------------------------------------
# Small library
# ---------------------------------------------------------------------------

section() {
  echo | tee -a "${LOG_FILE}"
  echo "==================================================================" | tee -a "${LOG_FILE}"
  echo "== $1" | tee -a "${LOG_FILE}"
  echo "==================================================================" | tee -a "${LOG_FILE}"
}

log() { echo "-- $1" | tee -a "${LOG_FILE}"; }

evidence() { echo "   EVIDENCE: $1" | tee -a "${LOG_FILE}"; }

gap() { echo "   GAP: $1" | tee -a "${LOG_FILE}"; }

fail() {
  echo | tee -a "${LOG_FILE}"
  echo "!! FAILED: $1" | tee -a "${LOG_FILE}"
  exit 1
}

idemp() { uuidgen; }

# req METHOD URL EXPECTED_STATUS [curl-args...]
# Issues a request, fails loudly with the full response body on an
# unexpected status, and prints the body to stdout on success so callers can
# capture it with $(...).
req() {
  local method="$1" url="$2" expected="$3"
  shift 3
  local response status body
  response="$(curl -sS -w '\n%{http_code}' -X "${method}" "${url}" "$@")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [ "${status}" != "${expected}" ]; then
    {
      echo "!! ${method} ${url} -> HTTP ${status}, expected ${expected}"
      echo "!! Response body:"
      echo "${body}" | (jq . 2>/dev/null || cat)
    } | tee -a "${LOG_FILE}" >&2
    exit 1
  fi
  echo "${body}"
}

psql_app() {
  docker compose exec -T -e PGPASSWORD="${DB_APP_PASSWORD}" "${DB_SERVICE}" \
    psql -v ON_ERROR_STOP=1 -U "${DB_APP_USER}" -d "${DB_NAME}" "$@"
}

psql_migrator() {
  docker compose exec -T -e PGPASSWORD="${DB_MIGRATOR_PASSWORD}" "${DB_SERVICE}" \
    psql -v ON_ERROR_STOP=1 -U "${DB_MIGRATOR_USER}" -d "${DB_NAME}" "$@"
}

kc_admin_token() {
  curl -sf -X POST "${KC}/realms/master/protocol/openid-connect/token" \
    -d "client_id=admin-cli" -d "username=${KC_ADMIN_USER}" -d "password=${KC_ADMIN_PASSWORD}" \
    -d "grant_type=password" | jq -r .access_token
}

# ---------------------------------------------------------------------------
# Phase 0: fresh stack
# ---------------------------------------------------------------------------

section "Phase 0: fresh stack"

log "docker compose down -v (this project's volumes are disposable)"
docker compose down -v 2>&1 | tee -a "${LOG_FILE}"

log "make up (Postgres, Kafka, Keycloak, OpenBao, MinIO; asserts Keycloak service-account roles)"
make up 2>&1 | tee -a "${LOG_FILE}"
evidence "make up completed without error — Keycloak realm import and ADR 0009 service-account role assignment are themselves under test here"

# GAP (compose.yaml, fixed by this change — not Java, no mvnw verify needed):
# openbao-seed never seeded object_storage/platform/media-{access,secret}-key
# or data_encryption/platform/handover-pepper. Those are required only when
# HORECAOS_SECRETS_PROVIDER=openbao (docs/development.md's own documented way
# to exercise the OpenBao path instead of the "environment" provider
# default), and this proving run needs the OpenBao path for real: payments'
# SecretResolver has no "environment" fallback for a tenant-scoped merchant
# secret, so a real (fake-provider) CLICK payment cannot be proved without
# it. Fixed directly in compose.yaml's openbao-seed step; see its comment.
log "Seeding the .env used for HORECAOS_SECRETS_PROVIDER=openbao (docs/development.md's documented path)"
if [ ! -f .env ]; then
  cp .env.example .env
fi
set -a
# shellcheck disable=SC1091
source .env
set +a

section "Phase 0: start the API"

# A stale `spring-boot:run` from an earlier session left bound to this port
# answers readiness checks (it is a healthy process) while talking to a
# database `down -v` just deleted — the exact failure this guard exists to
# turn into a clear message instead of a confusing mid-run SQL error.
API_PORT="$(printf '%s' "${API}" | sed -n 's#.*:\([0-9]\+\)$#\1#p')"
if [ -n "${API_PORT}" ] && lsof -i ":${API_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  fail "something is already listening on port ${API_PORT} (${API}) — likely a leftover 'mvnw spring-boot:run' from an earlier session, now talking to a database phase 0 just deleted. Stop it (check 'ps aux | grep spring-boot:run') and re-run."
fi

RUN_LOG_APP="/tmp/horecaos-proving-run-app-${RUN_SUFFIX}.log"
log "mvnw spring-boot:run -Dspring-boot.run.profiles=local (background, log: ${RUN_LOG_APP})"
nohup ./mvnw spring-boot:run -Dspring-boot.run.profiles=local > "${RUN_LOG_APP}" 2>&1 &
APP_PID=$!
log "app pid ${APP_PID}; waiting for readiness on ${API}/actuator/health/readiness"

READY=0
for _ in $(seq 1 90); do
  if curl -sf -o /dev/null "${API}/actuator/health/readiness"; then
    READY=1
    break
  fi
  if ! kill -0 "${APP_PID}" 2>/dev/null; then
    tail -n 80 "${RUN_LOG_APP}" | tee -a "${LOG_FILE}"
    fail "the application process exited before becoming ready; see ${RUN_LOG_APP}"
  fi
  sleep 5
done
[ "${READY}" = "1" ] || fail "the application never became ready within 450s; see ${RUN_LOG_APP}"
evidence "GET ${API}/actuator/health/readiness -> ready"

# ---------------------------------------------------------------------------
# Phase 1: identity bootstrap (local dev only — every accommodation named)
# ---------------------------------------------------------------------------

section "Phase 1: identity bootstrap"

# GAP (Keycloak, worked around with local-dev-only scripts, not a Java
# change): horecaos-realm.json ships no realm users and horecaos-api is
# bearerOnly with directAccessGrantsEnabled=false — correctly, it is the
# resource server, not something anybody signs into. Nothing in the realm
# supports non-interactive (password-grant) token acquisition, which this
# script needs to drive the API headlessly the way a human would through
# Swagger UI's Authorize button. infra/keycloak/create-local-dev-client.sh
# creates a confidential, direct-grant-enabled client scoped to local/loopback
# only, mirroring create-local-web-client.sh's own guard.
log "Creating the local-dev password-grant Keycloak client (infra/keycloak/create-local-dev-client.sh)"
DEV_CLIENT_SECRET="$(./infra/keycloak/create-local-dev-client.sh)"
evidence "client horecaos-local-dev created/updated, direct grants enabled, loopback-only"

# GAP (Keycloak, same class): no platform-admin realm user exists on a fresh
# deployment either — ADR 0003 deliberately leaves who holds the role to each
# deployment. infra/keycloak/create-platform-admin.sh creates one and assigns
# the horecaos-api platform-admin client role directly (a normal, global,
# non-org-scoped role mapping — nothing ADR-0009-specific).
log "Creating the platform-admin realm user (infra/keycloak/create-platform-admin.sh)"
HORECAOS_PLATFORM_ADMIN_PASSWORD="${PLATFORM_ADMIN_PASSWORD}" \
  ./infra/keycloak/create-platform-admin.sh "${PLATFORM_ADMIN_USERNAME}" >>"${LOG_FILE}" 2>&1
evidence "realm user ${PLATFORM_ADMIN_USERNAME} holds the horecaos-api platform-admin client role"

kc_token() {
  local username="$1" password="$2" scope="$3"
  curl -sS -X POST "${KC}/realms/${KC_REALM}/protocol/openid-connect/token" \
    -d "client_id=horecaos-local-dev" -d "client_secret=${DEV_CLIENT_SECRET}" \
    -d "grant_type=password" -d "username=${username}" -d "password=${password}" \
    ${scope:+-d "scope=${scope}"} | jq -r .access_token
}

ADMIN_TOKEN="$(kc_token "${PLATFORM_ADMIN_USERNAME}" "${PLATFORM_ADMIN_PASSWORD}" "")"
[ -n "${ADMIN_TOKEN}" ] && [ "${ADMIN_TOKEN}" != "null" ] || fail "could not acquire a platform-admin token"
ADMIN_SUBJECT="$(python3 -c "
import base64, json
t = '${ADMIN_TOKEN}'.split('.')[1]
t += '=' * (-len(t) % 4)
print(json.loads(base64.urlsafe_b64decode(t))['sub'])
")"
evidence "platform-admin token acquired; sub=${ADMIN_SUBJECT}"

# GAP (application code, worked around with one direct SQL insert — this is
# the load-bearing gap of the whole run, documented in
# docs/runbooks/proving-run.md as Gap A): the ADR 0025 fresh-deployment
# bootstrap bypass in JdbcAuthorizationService confers exactly one capability
# to a platform-admin realm-role holder — IAM_GRANT_MANAGE, at any scope —
# and nothing else, "so a platform admin can create the first grant and must
# then grant themselves everything else through the ordinary audited API."
# But GrantController's own grant endpoint is nested under
# /control-plane/tenants/{tenantId}/grants and can only ever construct a
# TENANT/BRAND/LOCATION scope from that path — never PLATFORM. There is
# therefore no HTTP endpoint anywhere in this codebase that can create a
# PLATFORM-scope grant, which is exactly what creating the very first tenant
# needs (TenantControlPlaneController.createTenant requires TENANT_WRITE at
# PLATFORM scope). Confirmed live: a fresh platform-admin token gets a plain
# 403 INSUFFICIENT_CAPABILITY from POST /control-plane/tenants before this.
# The one-time row below mirrors the exact shape
# ControlPlaneWiringIntegrationTests.grantPlatformAdministration already uses
# as a test fixture for the same reason: no API path exists, and the honest
# thing to do is name that rather than build an ad hoc endpoint under this
# task. iam.roles already carries the platform-admin row —
# RoleRegistrySynchronizer seeds it as an ApplicationRunner on every startup.
log "Bootstrapping the platform-admin's first grant directly in iam.grants (no PLATFORM-scope grant endpoint exists — see Gap A)"
psql_app <<SQL
INSERT INTO iam.grants
    (id, tenant_id, principal_subject, role_id, role_is_platform, scope_type, scope_id,
     status, granted_by, reason)
SELECT gen_random_uuid(), NULL, '${ADMIN_SUBJECT}', id, true, 'PLATFORM', NULL,
       'ACTIVE', 'tools/proving-run bootstrap', 'Fresh-deployment IAM_GRANT_MANAGE bypass cannot reach PLATFORM scope; see docs/runbooks/proving-run.md Gap A'
  FROM iam.roles WHERE code = 'platform-admin' AND tenant_id IS NULL
ON CONFLICT DO NOTHING;
SQL
evidence "iam.grants now carries a PLATFORM-scope platform-admin grant for ${ADMIN_SUBJECT}"

# GAP (application code, worked around with one direct SQL insert, same
# class as Gap A — named as Gap B in the runbook): tenant.onboarding_runs has
# a NOT NULL foreign key to tenant.onboarding_templates, and nothing in
# production code — no migration, no local-fixtures seed, no controller —
# ever creates a template row. Every test that starts a run inserts one by
# hand (OnboardingFullRunIntegrationTests.seedARealisticTenant, mirrored
# exactly below: code 'default', version 1, status ACTIVE, empty
# required_steps). Confirmed by reading OnboardingController/OnboardingService
# and grepping the whole tree for an OnboardingTemplateController that does
# not exist.
log "Seeding the onboarding template row (no authoring endpoint exists — see Gap B)"
TEMPLATE_ID="$(uuidgen | tr 'A-Z' 'a-z')"
psql_app <<SQL
INSERT INTO tenant.onboarding_templates (id, code, version, status, required_steps, created_by)
VALUES ('${TEMPLATE_ID}', 'default', 1, 'ACTIVE', '[]'::jsonb, 'tools/proving-run bootstrap')
ON CONFLICT DO NOTHING;
SQL
evidence "onboarding template ${TEMPLATE_ID} (code=default, version=1) seeded"

