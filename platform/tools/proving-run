ON CONFLICT (code) DO UPDATE SET base_url = EXCLUDED.base_url;
SQL

# The secret VALUE, not just its reference format, matters: FakeClickHttpProvider
# validates every merchant-API call's Auth header against
# FakeClickProviderConfiguration's own configured secret
# (horecaos.fake-providers.click.secret), whose default is exactly this
# string — the fake does not read OpenBao itself, so the resolved secret and
# the fake's own default must agree by construction, mirroring
# tools/seed-payments' own comment on this. Any other value authenticates as
# nothing and every provider call comes back "rejected the cached
# credential", which is indistinguishable from a real secret mismatch.
SECRET_REFERENCE="horecaos:local:provider_payment:${TENANT_SLUG}:click"
