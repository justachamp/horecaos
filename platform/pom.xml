<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>uz.horecaos</groupId>
    <artifactId>horecaos-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>HorecaOS Platform</name>
    <description>Multi-tenant SaaS commerce and delivery platform</description>

    <properties>
        <horecaos.test.forks>4</horecaos.test.forks>
        <java.version>25</java.version>
        <!-- ADR 0054. The coverage floor may only rise. Raise it when coverage
             rises; never lower it to admit a change. Measured 0.7879 line
             coverage at adoption (2026-08-30) on the final, spotless-formatted
             tree — reformatting shifts JaCoCo's line count, so the floor is
             pinned to post-format coverage, not the pre-format reading.
             Floor set to that value rounded down to the next lower 0.5
             percentage point. -->
        <horecaos.coverage.floor>0.785</horecaos.coverage.floor>
        <jacoco.version>0.8.15</jacoco.version>
        <spotless.version>3.10.1</spotless.version>
        <palantir-java-format.version>2.97.0</palantir-java-format.version>
        <error-prone.version>2.50.0</error-prone.version>
        <nullaway.version>0.14.1</nullaway.version>
        <jspecify.version>1.0.1</jspecify.version>
        <dependency-check.version>13.0.0</dependency-check.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.outputTimestamp>2026-08-18T00:00:00Z</project.build.outputTimestamp>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <camel.version>4.22.0</camel.version>
        <springdoc.version>3.0.3</springdoc.version>
        <json-schema-validator.version>1.5.8</json-schema-validator.version>
        <aws-sdk.version>2.54.1</aws-sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <!-- ADR 0054 NullAway follow-up. The @Nullable/@NonNull family
                 NullAway's default configuration recognises (simple-name
                 match) and the modern, framework-neutral choice for a
                 codebase with no prior nullability annotations — jspecify is
                 the annotation set NullAway's own docs recommend adopting
                 going forward. `provided` scope: these are source/compile-time
                 markers (RUNTIME retention for reflection tools, but nothing
                 here reads them at runtime) and must not ship in the
                 application artifact. -->
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
        </dependency>
        <!-- Circuit breaking for provider routes (ADR 0007). Camel's core DSL
             declares circuitBreaker() but needs an implementation behind it;
             without this the declaration silently degrades to a plain call. -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-resilience4j-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-observability-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <!-- ADR 0010 object storage. The SDK is used for its SigV4 signer and
                 presigner: hand-rolling request signing is a well-known source of
                 subtle, intermittent auth failures. -->
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <!-- ADR 0033 in-process caching. A shared cache is deliberately
                 deferred until a measured cross-replica need exists. -->
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <!-- ADR 0032 event contract gate: schema validation and compatibility checks
                 run at build time, so this stays out of the runtime classpath. -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- ADR 0054. Error Prone + NullAway on every compile, all
                     findings demoted to warnings (-XepAllErrorsAsWarnings,
                     which also covers NullAway's own default ERROR severity).
                     Promotion to build-failing errors is a follow-up change
                     per check family, made when its warning count is zero.
                     NullAway is scoped to this codebase's own packages so it
                     does not report on framework or library code it cannot
                     annotate. The JDK export/opens flags Error Prone's javac
                     plugin needs live in .mvn/jvm.config. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <!-- Required alongside -XDcompilePolicy=simple: without it,
                             javac's default ifError=INIT stop policy runs before
                             the Error Prone plugin gets a chance to see the tree. -->
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -Xep:StringConcatToTextBlock:OFF -XepOpt:NullAway:AnnotatedPackages=uz.horecaos.platform</arg>
                        <!-- StringConcatToTextBlock is OFF because the checker itself crashes
                             (Iterables.getLast inside matchLiteral) on valid code in
                             FiscalObligationService — a tool bug, not a finding; re-enable on
                             an Error Prone release that fixes it. -->
                        <!-- javac's default -Xmaxwarns is 100: past that count it
                             silently drops the rest of the diagnostics for that
                             compilation unit set, with no error and no summary
                             line distinguishable from "no more warnings". The
                             2026-08-30 adoption inventory in ADR 0054 was
                             measured without this flag and undercounted for
                             exactly that reason (100 main + 100 test = 200,
                             suspiciously exact). Set high enough that this
                             codebase's whole warning count is never silently
                             truncated again. -->
                        <arg>-Xmaxwarns</arg>
                        <arg>100000</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- ADR 0054. One whole-tree spotless:apply commit, then
                     spotless:check bound to verify, absolute (no ratchet).
                     `make format` runs spotless:apply. -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Tests run in parallel PROCESSES, never in parallel threads
                        inside one process, and the distinction is the whole design.

                        A fork is a JVM, so it gets its own TestDatabase statics,
                        which means its own PostgreSQL container and therefore its
                        own cluster. Every hazard that makes a suite flaky under
                        in-JVM parallelism stops existing rather than having to be
                        reasoned about: static mutable fixtures, shared caches, and
                        above all the three suites that CREATE ROLE — roles are
                        cluster-wide, not per-database, so two of them sharing a
                        cluster concurrently is the one collision a per-class
                        database cannot prevent. (Their names differ today —
                        audit_app_probe, policy_app_probe — so they would survive
                        it; separate clusters mean nobody has to keep noticing.)

                        Set from a property so a constrained machine can turn it
                        down without editing the build:
                        `./mvnw verify -Dhorecaos.test.forks=1` is the old behaviour.

                        Four rather than 1C. Each fork costs a JVM plus a
                        PostgreSQL, and the fixed prologue — container start plus
                        the template migration — is about 1.75s that every fork
                        pays. Eighteen forks would spend more on prologue and
                        memory than they save, and the suite's time is concentrated:
                        the top ten classes are roughly half of it, so the win comes
                        from spreading those, not from maximum width.
                    -->
                    <forkCount>${horecaos.test.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- ADR 0054. jacoco:prepare-agent below sets the "argLine"
                         property to its javaagent flag; @{argLine} defers
                         resolution until surefire actually forks, which is what
                         lets JaCoCo's instrumentation compose with (rather than
                         be clobbered by) whatever else ends up in argLine. -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- ADR 0054. Coverage measured on every `verify`. prepare-agent
                     instruments the 4 surefire forks above via the argLine
                     composition; report renders it; check enforces the
                     one-way floor recorded in horecaos.coverage.floor. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${horecaos.coverage.floor}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-runtime</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>HorecaOS Platform requires JDK 25.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!-- ADR 0054. Two managed versions for the same
                                     dependency in dependencyManagement mean one
                                     silently shadows the other. -->
                                <banDuplicatePomDependencyVersions/>
                                <!-- ADR 0054. Passes clean out of the box; kept
                                     as a floor against future divergence.
                                     requireUpperBoundDeps was tried too but
                                     fails today on real conflicts (httpclient5/
                                     httpcore5 via the AWS SDK's apache5-client,
                                     io.prometheus:prometheus-metrics-* via
                                     micrometer) and is left out rather than
                                     added to the pom unmet. -->
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- ADR 0054. OWASP dependency-check against live NVD data. Kept out
                 of the per-commit path — NVD pulls add minutes per build for
                 information that changes daily, not per commit — and run
                 instead by the weekly .github/workflows/security-audit.yml via
                 `./mvnw -Psecurity-audit dependency-check:check`. -->
            <id>security-audit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- nvdApiKeyEnvironmentVariable (not nvdApiKey
                                 directly) is the documented mechanism for an
                                 optional key: the plugin reads the named
                                 environment variable itself at run time, so an
                                 unset NVD_API_KEY is absence, not an explicit
                                 empty key. Passing an explicit empty string
                                 through ${env.NVD_API_KEY} instead fails hard
                                 ("Invalid API Key, length of 0") — this is the
                                 fix for that. Unset, the plugin runs
                                 unauthenticated and more slowly; NVD throttles
                                 unkeyed requests heavily enough that a full
                                 scan may not finish in CI without a key. -->
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
