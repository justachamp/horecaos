    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- ADR 0054. Error Prone + NullAway on every compile. Promoted
                     off -XepAllErrorsAsWarnings on 2026-08-31: the full-tree
                     inventory (regenerated after fixing the -Xmaxwarns
                     undercount below) reached zero findings, including
                     NullAway, whose 29 remaining @SuppressWarnings("NullAway")
                     sites each carry a one-line justification rather than
                     being unexplained. Error Prone's own default-ERROR checks
                     and NullAway's default-ERROR severity (spelled out
                     explicitly below rather than left implicit) now fail the
                     build. NullAway is scoped to this codebase's own packages
                     so it does not report on framework or library code it
                     cannot annotate. The JDK export/opens flags Error Prone's
                     javac plugin needs live in .mvn/jvm.config. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <!-- Required alongside -XDcompilePolicy=simple: without it,
                             javac's default ifError=INIT stop policy runs before
                             the Error Prone plugin gets a chance to see the tree. -->
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne -Xep:StringConcatToTextBlock:OFF -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=uz.horecaos.platform</arg>
                        <!-- StringConcatToTextBlock is OFF because the checker itself crashes
                             (Iterables.getLast inside matchLiteral) on valid code in
                             FiscalObligationService — a tool bug, not a finding; re-enable on
                             an Error Prone release that fixes it. -->
                        <!-- javac's default -Xmaxwarns is 100: past that count it
                             silently drops the rest of the diagnostics for that
                             compilation unit set, with no error and no summary
                             line distinguishable from "no more warnings". The
                             2026-08-30 adoption inventory in ADR 0054 was
                             measured without this flag and undercounted for
                             exactly that reason (100 main + 100 test = 200,
                             suspiciously exact). Set high enough that this
                             codebase's whole warning count is never silently
                             truncated again. -->
                        <arg>-Xmaxwarns</arg>
                        <arg>100000</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- ADR 0054. One whole-tree spotless:apply commit, then
                     spotless:check bound to verify, absolute (no ratchet).
                     `make format` runs spotless:apply. -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Tests run in parallel PROCESSES, never in parallel threads
                        inside one process, and the distinction is the whole design.

                        A fork is a JVM, so it gets its own TestDatabase statics,
                        which means its own PostgreSQL container and therefore its
                        own cluster. Every hazard that makes a suite flaky under
                        in-JVM parallelism stops existing rather than having to be
                        reasoned about: static mutable fixtures, shared caches, and
                        above all the three suites that CREATE ROLE — roles are
                        cluster-wide, not per-database, so two of them sharing a
                        cluster concurrently is the one collision a per-class
                        database cannot prevent. (Their names differ today —
                        audit_app_probe, policy_app_probe — so they would survive
                        it; separate clusters mean nobody has to keep noticing.)

                        Set from a property so a constrained machine can turn it
                        down without editing the build:
                        `./mvnw verify -Dhorecaos.test.forks=1` is the old behaviour.

                        Four rather than 1C. Each fork costs a JVM plus a
                        PostgreSQL, and the fixed prologue — container start plus
                        the template migration — is about 1.75s that every fork
                        pays. Eighteen forks would spend more on prologue and
                        memory than they save, and the suite's time is concentrated:
                        the top ten classes are roughly half of it, so the win comes
                        from spreading those, not from maximum width.
                    -->
                    <forkCount>${horecaos.test.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- ADR 0054. jacoco:prepare-agent below sets the "argLine"
                         property to its javaagent flag; @{argLine} defers
                         resolution until surefire actually forks, which is what
                         lets JaCoCo's instrumentation compose with (rather than
                         be clobbered by) whatever else ends up in argLine. -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- ADR 0054. Coverage measured on every `verify`. prepare-agent
                     instruments the 4 surefire forks above via the argLine
                     composition; report renders it; check enforces the
                     one-way floor recorded in horecaos.coverage.floor. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${horecaos.coverage.floor}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-runtime</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>HorecaOS Platform requires JDK 25.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!-- ADR 0054. Two managed versions for the same
                                     dependency in dependencyManagement mean one
                                     silently shadows the other. -->
                                <banDuplicatePomDependencyVersions/>
                                <!-- ADR 0054. Passes clean out of the box; kept
                                     as a floor against future divergence.
                                     requireUpperBoundDeps was tried too but
                                     fails today on real conflicts (httpclient5/
                                     httpcore5 via the AWS SDK's apache5-client,
                                     io.prometheus:prometheus-metrics-* via
                                     micrometer) and is left out rather than
                                     added to the pom unmet. -->
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- ADR 0054. OWASP dependency-check against live NVD data. Kept out
                 of the per-commit path — NVD pulls add minutes per build for
                 information that changes daily, not per commit — and run
                 instead by the weekly .github/workflows/security-audit.yml via
                 `./mvnw -Psecurity-audit dependency-check:check`. -->
            <id>security-audit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- nvdApiKeyEnvironmentVariable (not nvdApiKey
                                 directly) is the documented mechanism for an
                                 optional key: the plugin reads the named
                                 environment variable itself at run time, so an
                                 unset NVD_API_KEY is absence, not an explicit
                                 empty key. Passing an explicit empty string
                                 through ${env.NVD_API_KEY} instead fails hard
                                 ("Invalid API Key, length of 0") — this is the
                                 fix for that. This mechanism is documented to
                                 fall back to slower, unauthenticated NVD
                                 access when unset, but confirmed 2026-09-08
                                 (see this ADR's run log) that
                                 dependency-check-maven 13.0.0 does not honor
                                 that fallback: an unset NVD_API_KEY still
                                 hard-fails with the same "Invalid API Key,
                                 length of 0" error before any analysis runs
                                 (dependency-check/DependencyCheck#7517,
                                 #8715). A real key from
                                 https://nvd.nist.gov/developers/request-an-api-key
                                 is required to run this profile at all in
                                 this plugin version, not merely to run it
                                 faster. -->
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
