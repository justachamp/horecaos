        <java.version>25</java.version>
        <!-- ADR 0054. The coverage floor may only rise. Raise it when coverage
             rises; never lower it to admit a change. Measured 0.7879 line
             coverage at adoption (2026-08-30) on the final, spotless-formatted
             tree — reformatting shifts JaCoCo's line count, so the floor is
             pinned to post-format coverage, not the pre-format reading.
             Floor set to that value rounded down to the next lower 0.5
             percentage point. -->
        <horecaos.coverage.floor>0.785</horecaos.coverage.floor>
