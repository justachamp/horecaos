        <java-uuid-generator.version>5.2.0</java-uuid-generator.version>
        <!-- spring-boot-dependencies 4.1.1 manages kafka.version at 4.2.1;
             overridden here to the latest 4.x patch (4.3.1) per the same
             child-property mechanism Spring Boot documents for every managed
             dependency. No CVE forces this specific bump — the 4.2.1 the BOM
             already carries has no known advisory in the 4.2.x/4.3.x range —
             but it keeps kafka-clients and the rest of the kafka.version-keyed
             artifacts (kafka-metadata, kafka-streams, ...) on the same current
             release train the CLAUDE.md stack line already commits to
             ("Kafka 4.3"). -->
        <kafka.version>4.3.1</kafka.version>
        <!-- spring-boot-dependencies 4.1.1 manages tomcat.version at 11.0.24,
             and the OWASP scheduled scan of 2026-09-08 (run 34248754358) found
             every one of its eleven remaining findings there and nowhere else:
             four scored 9.x, including CVE-2026-65637 and CVE-2026-65905 at 9.8.
             Boot 4.1.1 had already closed the other sixty-six the previous run
             reported, so this single override is what is left between the
             platform and a clean scan. 11.0.25 is the current 11.0.x release.
             Overridden by the same child-property mechanism kafka.version uses
             above, and the scan is re-run after this lands rather than assumed
             to have worked: a version bump that does not actually clear the
             advisory is worth knowing about before launch, not after. -->
        <tomcat.version>11.0.25</tomcat.version>
    </properties>

    <dependencies>
        <dependency>
            <!-- ADR 0054 NullAway follow-up. The @Nullable/@NonNull family
                 NullAway's default configuration recognises (simple-name
                 match) and the modern, framework-neutral choice for a
                 codebase with no prior nullability annotations — jspecify is
                 the annotation set NullAway's own docs recommend adopting
                 going forward. `provided` scope: these are source/compile-time
                 markers (RUNTIME retention for reflection tools, but nothing
                 here reads them at runtime) and must not ship in the
                 application artifact. -->
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
        </dependency>
