        <dependency>
            <!-- ADR 0010 object storage. The SDK is used for its SigV4 signer and
                 presigner: hand-rolling request signing is a well-known source of
                 subtle, intermittent auth failures. -->
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <!-- ADR 0033 in-process caching. A shared cache is deliberately
                 deferred until a measured cross-replica need exists. -->
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <!-- ADR 0032 event contract gate: schema validation and compatibility checks
                 run at build time, so this stays out of the runtime classpath. -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- ADR 0059: parses the conversations module's flow YAML documents.
                 Already on the runtime classpath transitively (Spring Boot's own
                 application.yml processing pulls it in); declared explicitly here
                 because this module depends on it directly rather than only
                 benefiting from another dependency's transitive pull. Version
                 governed by spring-boot-starter-parent's own dependency management. -->
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <!-- ADR 0059 stage 3: parses a SendPulse CSV contact export. Naive
                 comma-splitting breaks on the quoted commas a real export's
                 name/tag columns carry; hand-rolling RFC 4180 quoting is
                 exactly the kind of parser bug this dependency exists to
                 avoid. Not in spring-boot-starter-parent's dependency
                 management, so pinned explicitly. -->
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <!-- ADR 0076: RFC 9562 UUIDv7 generation for row identity
                 (uz.horecaos.platform.configuration.Ids). The owner's answer
                 to the ADR's "dependency or hand-rolled" open input
                 (2026-09-08): prefer a maintained Maven Central library over
                 ~20 lines of this platform's own bit-twiddling. Verified
                 current on Maven Central as of this change (5.2.0,
                 2025-12-05); its only runtime dependency is slf4j-api, already
                 on this application's classpath via Spring Boot's own
                 logging, so this does not widen the transitive dependency
                 surface the ADR's own alternatives table worried about. Not
                 managed by spring-boot-starter-parent's BOM, so pinned
                 explicitly. -->
            <groupId>com.fasterxml.uuid</groupId>
            <artifactId>java-uuid-generator</artifactId>
            <version>${java-uuid-generator.version}</version>
