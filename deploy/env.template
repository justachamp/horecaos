# Template for the per-environment file ADR 0061 names as the ONLY artifact
# that may vary between the Sarkor production box, a staging VM on a
# different provider, and a developer's local smoke test.
#
# Copy this file, fill it in, and keep the result OUTSIDE this repository
# (production-setup.md has the exact path: /etc/horecaos/production.env on
# the production host). It is read by `deploy/compose.production.yml`
# through `--env-file`.
#
# Every value in this file is public information — a hostname, an image tag,
# a resource limit, a bucket name. There is no password here, no token, and
# no key, and none may EVER be added: real credentials reach the containers
# from OpenBao at deploy time (ADR 0028), never from a file on this host's
# disk. If you find yourself wanting to add one, that is the signal to put
# it in OpenBao instead and reference it the way HORECAOS_MEDIA_ACCESS_KEY_REF
# already does in deploy/compose.production.yml.
#
# The compose file uses `${VAR:?message}` for everything with no safe
# default, so a missing line fails `docker compose config` immediately, by
# name, rather than starting something subtly wrong.
#
# See deploy/env.staging.example for a filled example on a different
# provider, and deploy/env.local-test for what the local proof overrides.


# --- Registry and release --------------------------------------------------

# Where CI publishes pinned images (.github/workflows/ci.yml, job
# `publish-images`). ghcr.io is the recommendation (ADR 0061 leaves registry
# choice an open input; ghcr costs nothing extra with the existing GitHub and
# needs no secret beyond the CI-provided GITHUB_TOKEN) -- override this one
# variable to point at a different registry entirely, which is the whole of
# what "portable registry choice" means in practice.
HORECAOS_REGISTRY=ghcr.io/justachamp/horecaos

# The backend release tag: normally the short git SHA CI built and pushed.
# The frontend tag is usually the same value -- the three Angular apps and
# the platform image are built from the same commit by the same CI run --
# but is a separate variable because a frontend-only hotfix (a copy change,
# no backend touch) can ship on its own tag without moving the backend.
HORECAOS_IMAGE_TAG=
HORECAOS_FRONTEND_IMAGE_TAG=

# The postgres+postgis image changes far less often than the application --
# only when the Dockerfile in platform/infra/postgres changes. Pinned
# separately so a routine backend release never has to reason about whether
# the database image also moved.
HORECAOS_POSTGRES_IMAGE_TAG=18


# --- Public identity of the deployment --------------------------------------

# Origins, with scheme. These are what Caddy serves, what Keycloak issues
# tokens for, and what the application validates the `iss` claim against.
# Changing one without the others is the most common way to make every token
# invalid.
HORECAOS_API_ORIGIN=https://api.horecaos.uz
HORECAOS_AUTH_ORIGIN=https://auth.horecaos.uz
HORECAOS_MEDIA_ORIGIN=https://media.horecaos.uz
HORECAOS_STOREFRONT_ORIGIN=https://horecaos.uz
HORECAOS_OPERATIONS_ORIGIN=https://operations.horecaos.uz
HORECAOS_CONTROL_PLANE_ORIGIN=https://admin.horecaos.uz

# The same names without a scheme. Used as Docker network aliases so the
# application can resolve the auth hostname without leaving the host -- see
# the comment on the `edge` service in deploy/compose.production.yml.
HORECAOS_API_HOSTNAME=api.horecaos.uz
HORECAOS_AUTH_HOSTNAME=auth.horecaos.uz
HORECAOS_MEDIA_HOSTNAME=media.horecaos.uz

# Where certificate-expiry notices go. A real, monitored mailbox -- this is
# the warning that arrives before a full outage.
HORECAOS_ACME_EMAIL=ops@horecaos.uz

# Leave EMPTY in production and staging: an empty value makes Caddy request
# a real Let's Encrypt certificate. deploy/env.local-test is the only file
# that sets this to `internal`, which switches Caddy to its own local CA so
# the smoke test never touches the public internet or a rate limit.
HORECAOS_TLS_MODE=

# The environment segment OpenBao secret references resolve against (ADR
# 0028/0040) -- `production` on the Sarkor box, `staging` on the aHOST/UzCloud
# VM. This is what makes the SAME compose file and the SAME image read a
# DIFFERENT secret store depending on where it runs.
HORECAOS_ENVIRONMENT=production


# --- The pilot storefront build --------------------------------------------

# storefront-web bakes no tenant configuration into its image (it reads
# config.json at runtime, same pattern as control-plane's config.js), but it
# does need to be told at container-start which tenant/brand/location this
# particular deployment is serving -- HorecaOS's launch scope is one pilot
# tenant on one storefront container, not a multi-tenant router yet (ADR
# 0055). Values come from the tenant onboarded through the control plane;
# see docs/runbooks/production-setup.md, "First boot".
HORECAOS_STOREFRONT_API_BASE_URL=/api/v1
HORECAOS_STOREFRONT_TENANT_ID=
HORECAOS_STOREFRONT_BRAND_ID=
HORECAOS_STOREFRONT_LOCATION_ID=
HORECAOS_YANDEX_MAPS_API_KEY=


# --- Kafka -------------------------------------------------------------------

# Generate ONCE with `kafka-storage.sh random-uuid` and never change it. The
# broker refuses to start against a data directory formatted with a
# different cluster id.
HORECAOS_KAFKA_CLUSTER_ID=


# --- Object storage ----------------------------------------------------------

# Not "minioadmin", not "admin", and not the same as anything else. The
# password for it is generated during bootstrap and lives in OpenBao.
HORECAOS_MINIO_ROOT_USER=
HORECAOS_MEDIA_BUCKET=horecaos-media
HORECAOS_MEDIA_REGION=us-east-1


# --- Backups -----------------------------------------------------------------

HORECAOS_BACKUP_BUCKET=horecaos-backups
HORECAOS_BACKUP_S3_ENDPOINT=http://minio:9000
HORECAOS_BACKUP_RETENTION_DAYS=30

# REQUIRED. The nightly backup refuses to run without it: a backup that
# exists only on the machine it is backing up is not a backup (ADR 0034/
# ADR 0061's "backups leave the machine but not the country").
#
# The default candidate is UzCloud S3 (in-country, keeps the restore path
# inside the same legal jurisdiction the ADR chose to keep this simple) --
# any S3-compatible endpoint works, which is the whole point of never using
# a provider-specific storage API here.
#
# Credentials for this destination live in OpenBao under
# production/object_storage/platform/backup-offsite-{access,secret}-key and
# are resolved inside the `ops` container -- never here, because this file
# is readable on the host. The bucket needs versioning and object-lock so a
# stolen key can add history but not delete it, and the backup passphrase
# must NOT live in the same account as this destination (one compromise
# should not yield both the ciphertext and the key).
HORECAOS_BACKUP_OFFSITE_ENDPOINT=
HORECAOS_BACKUP_OFFSITE_BUCKET=


# --- Database roles: deliberately NOT here -----------------------------------
#
# There is no HORECAOS_DB_USERNAME line here and there must never be one.
# deploy/compose.production.yml pins the application to `horecaos_app` and the
# migration job to `horecaos_migrator` -- which role the application connects
# as is not a site setting, it is the security boundary every GRANT and
# REVOKE in the migrations depends on. DatabasePrivilegeGuard refuses to
# start any non-local profile whose connection is a superuser or the
# database owner, so an override here would fail the deploy rather than
# weaken it silently -- that refusal is the backstop, not the design.


# --- Sizing ------------------------------------------------------------------
#
# ADR 0061 names this the open input that most needs verifying against the
# real Sarkor box: Kafka, Keycloak, PostgreSQL and the JVM all share one
# machine. Defaults below assume a 16 GB / 8 vCPU host (the same assumption
# platform/infra/production/README.md's resource budget documents) and add
# up to roughly 12.5 GB, leaving headroom for the kernel, the page cache
# PostgreSQL depends on, and a deploy that briefly runs an old and a new
# container together. Raise or lower against a measurement, not a hunch --
# deploy/env.staging.example shows a smaller VM's values.
HORECAOS_APP_CPU_LIMIT=4.0
HORECAOS_APP_MEMORY_LIMIT=2G
HORECAOS_APP_MEMORY_RESERVATION=1G

HORECAOS_DB_CPU_LIMIT=4.0
HORECAOS_DB_MEMORY_LIMIT=4G
HORECAOS_DB_MEMORY_RESERVATION=2G
HORECAOS_DB_SHARED_BUFFERS=1GB
HORECAOS_DB_EFFECTIVE_CACHE_SIZE=3GB
HORECAOS_DB_WORK_MEM=16MB
HORECAOS_DB_MAINTENANCE_WORK_MEM=256MB
HORECAOS_DB_MAX_CONNECTIONS=100

# Hikari's ceiling. Must stay well under HORECAOS_DB_MAX_CONNECTIONS, with
# room for the migration job, the ops container, and a human with psql.
HORECAOS_DB_MAX_POOL_SIZE=20
HORECAOS_DB_MIN_IDLE=4


# --- Set by the deploy procedure, not by hand --------------------------------
#
# HORECAOS_SECRET_DIR    the tmpfs holding the startup secrets, created fresh
#                        by every deploy -- see production-setup.md
#
# Listed here only so nobody adds it to this file and wonders why every
# deploy behaves the same regardless of what they typed.
