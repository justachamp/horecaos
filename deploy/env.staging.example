# Filled example: staging on a small aHOST VM.
#
# ADR 0061 requires staging to run on a DIFFERENT provider than production
# (the Sarkor box) -- not because aHOST is better, but because a release
# that only ever deploys to the box it was designed for proves nothing about
# portability. This file is what makes that literal: every value below is
# provider-specific, and nothing in deploy/compose.production.yml or any
# Dockerfile changes to produce it.
#
# Copy this to /etc/horecaos/staging.env on the staging VM, fill in the
# blanks the comments below still name, and chmod 0600 it -- the same rule
# as the production file, because the same "no credential in this file"
# guarantee applies here too.
#
# This is an EXAMPLE for a hypothetical VM. Hostnames, the cluster id, and
# the tenant/brand/location ids are illustrative -- generate real ones for
# a real staging box exactly as production-setup.md's "Configure" section
# describes, just pointed at staging.horecaos.uz instead of horecaos.uz.

# --- Registry and release ---------------------------------------------------

HORECAOS_REGISTRY=ghcr.io/justachamp/horecaos
# Staging deploys whatever commit is under test, not necessarily what
# production is running -- typically the tip of a release branch's CI run.
HORECAOS_IMAGE_TAG=a1b2c3d
HORECAOS_FRONTEND_IMAGE_TAG=a1b2c3d
HORECAOS_POSTGRES_IMAGE_TAG=18


# --- Public identity of the deployment --------------------------------------

HORECAOS_API_ORIGIN=https://api.staging.horecaos.uz
HORECAOS_AUTH_ORIGIN=https://auth.staging.horecaos.uz
HORECAOS_MEDIA_ORIGIN=https://media.staging.horecaos.uz
HORECAOS_STOREFRONT_ORIGIN=https://staging.horecaos.uz
HORECAOS_OPERATIONS_ORIGIN=https://operations.staging.horecaos.uz
HORECAOS_CONTROL_PLANE_ORIGIN=https://admin.staging.horecaos.uz

HORECAOS_API_HOSTNAME=api.staging.horecaos.uz
HORECAOS_AUTH_HOSTNAME=auth.staging.horecaos.uz
HORECAOS_MEDIA_HOSTNAME=media.staging.horecaos.uz

HORECAOS_ACME_EMAIL=ops@horecaos.uz
HORECAOS_TLS_MODE=

# The OpenBao path segment. Staging secrets live at horecaos/staging/*,
# entirely separate from horecaos/production/* -- a staging AppRole cannot
# read a production credential even if someone points it at the same
# OpenBao path prefix by mistake, because the segment itself differs.
HORECAOS_ENVIRONMENT=staging

# Payme has no staging endpoint of its own that calls back to a VM here, so
# there is nothing real to allowlist yet -- left unset deliberately, which
# makes deploy/compose.production.yml default it to a non-routable address
# and the edge reject every /providers/payme/* call. That is correct for
# staging: see env.template's own comment before filling this in for a real
# production deployment.
HORECAOS_PAYME_ALLOWED_IPS=


# --- The pilot storefront build ---------------------------------------------

HORECAOS_STOREFRONT_API_BASE_URL=/api/v1
# A dedicated staging tenant, never the production pilot's ids -- staging
# data is disposable and gets recreated by the proving run on every release.
HORECAOS_STOREFRONT_TENANT_ID=20000000-0000-0000-0000-000000000001
HORECAOS_STOREFRONT_BRAND_ID=20000000-0000-0000-0000-000000000002
HORECAOS_STOREFRONT_LOCATION_ID=20000000-0000-0000-0000-000000000003
HORECAOS_YANDEX_MAPS_API_KEY=


# --- Kafka -------------------------------------------------------------------

# Generated once for this VM with `kafka-storage.sh random-uuid`; a different
# value than production's, because they are different clusters.
HORECAOS_KAFKA_CLUSTER_ID=b7e1a2f0-0000-4000-8000-000000000000


# --- Object storage ----------------------------------------------------------

HORECAOS_MINIO_ROOT_USER=horecaos-staging-root
HORECAOS_MEDIA_BUCKET=horecaos-staging-media
HORECAOS_MEDIA_REGION=us-east-1


# --- Backups -----------------------------------------------------------------

HORECAOS_BACKUP_BUCKET=horecaos-staging-backups
HORECAOS_BACKUP_S3_ENDPOINT=http://minio:9000
# Shorter retention than production: staging is a rehearsal environment, and
# a month of nightly staging dumps buys nothing production's own retention
# does not already prove.
HORECAOS_BACKUP_RETENTION_DAYS=7
# The monthly restore rehearsal (ADR 0061) restores a PRODUCTION backup onto
# staging, so staging's own off-site target only needs to exist, not be a
# second copy of anything precious. UzCloud S3 again, a different bucket
# than production's.
HORECAOS_BACKUP_OFFSITE_ENDPOINT=https://s3.uzcloud.uz
HORECAOS_BACKUP_OFFSITE_BUCKET=horecaos-staging-backups-offsite


# --- Sizing ------------------------------------------------------------------
#
# aHOST's smallest VM this stack has been sized against: 4 vCPU / 8 GB. Half
# of production's limits, which is enough to run the proving run and prove
# portability -- it is not meant to carry production traffic, and the SLO
# this ADR sets (99% on the Sarkor box) says nothing about staging capacity.
HORECAOS_APP_CPU_LIMIT=2.0
HORECAOS_APP_MEMORY_LIMIT=1G
HORECAOS_APP_MEMORY_RESERVATION=512M

HORECAOS_DB_CPU_LIMIT=2.0
HORECAOS_DB_MEMORY_LIMIT=2G
HORECAOS_DB_MEMORY_RESERVATION=1G
HORECAOS_DB_SHARED_BUFFERS=512MB
HORECAOS_DB_EFFECTIVE_CACHE_SIZE=1536MB
HORECAOS_DB_WORK_MEM=8MB
HORECAOS_DB_MAINTENANCE_WORK_MEM=128MB
HORECAOS_DB_MAX_CONNECTIONS=50

HORECAOS_DB_MAX_POOL_SIZE=10
HORECAOS_DB_MIN_IDLE=2
