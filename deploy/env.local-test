# Env file for deploy/local-smoke.sh ONLY. Never copy this onto a server.
#
# Every value below is either a non-routable local test value or points at
# a port/hostname combination that only resolves inside the smoke test's own
# curl calls (via `--resolve`, not real DNS). HORECAOS_ENVIRONMENT stays
# `production` on purpose — see the comment on that line.

# --- Registry and release ---------------------------------------------------
#
# No registry: local-smoke.sh builds every image straight from this checkout
# and tags it under this namespace, then runs `docker compose up` without a
# `pull`, so compose uses the image already in the local Docker engine. This
# namespace exists so a smoke-test image can never collide with a tag the
# dev stack (`make up`) or a real registry pull would use.
HORECAOS_REGISTRY=horecaos-smoke
HORECAOS_IMAGE_TAG=local
HORECAOS_FRONTEND_IMAGE_TAG=local
HORECAOS_POSTGRES_IMAGE_TAG=local

# --- Public identity of the deployment --------------------------------------
#
# `.test` is IANA-reserved for exactly this (RFC 2606) — guaranteed to never
# resolve on the real internet. The explicit :18443 is what makes Caddy bind
# that port instead of 443 inside the container; see
# deploy/compose.local-test.override.yml for the matching host mapping.
HORECAOS_API_ORIGIN=https://api.horecaos.test:18443
HORECAOS_AUTH_ORIGIN=https://auth.horecaos.test:18443
HORECAOS_MEDIA_ORIGIN=https://media.horecaos.test:18443
HORECAOS_STOREFRONT_ORIGIN=https://storefront.horecaos.test:18443
HORECAOS_OPERATIONS_ORIGIN=https://operations.horecaos.test:18443
HORECAOS_CONTROL_PLANE_ORIGIN=https://admin.horecaos.test:18443

HORECAOS_API_HOSTNAME=api.horecaos.test
HORECAOS_AUTH_HOSTNAME=auth.horecaos.test
HORECAOS_MEDIA_HOSTNAME=media.horecaos.test

HORECAOS_ACME_EMAIL=smoke-test@example.invalid

# The one line that makes this a local run rather than an attempt to reach
# Let's Encrypt for a domain nobody owns: Caddy issues from its own internal
# CA instead. `local-smoke.sh` pulls that CA's root certificate out of the
# `edge-data` volume so its own curl calls can verify the chain instead of
# using `-k` and proving nothing about whether the certificate is even
# well-formed.
HORECAOS_TLS_MODE=internal

# Deliberately `production`, not `local-smoke`: deploy/infra/openbao/agent.hcl
# is the literal file production uses, and its one Vault template hardcodes
# the `production` path segment (see that file's own comment on why there is
# exactly one template). Proving the unmodified production artifact means
# seeding OpenBao at the same path it already reads, not a parallel one this
# script would have to fork the agent config to reach. This OpenBao instance
# is thrown away with the rest of the stack at the end of the run, so the
# word "production" here names a path, not a claim about the data.
HORECAOS_ENVIRONMENT=production

# --- The pilot storefront build ---------------------------------------------
#
# Matches the fixture ids in platform/docs/local-fixtures.md ONLY as
# arbitrary, well-known-format UUIDs — the local-smoke stack runs Flyway's
# ordinary `db/migration` location, never `db/local-fixtures`, so no tenant
# with this id actually exists. That mismatch is deliberate: it is what lets
# the smoke test assert the fixtureless "no such tenant" response is honest
# rather than accidentally hitting real seeded data.
HORECAOS_STOREFRONT_API_BASE_URL=/api/v1
HORECAOS_STOREFRONT_TENANT_ID=10000000-0000-0000-0000-000000000001
HORECAOS_STOREFRONT_BRAND_ID=10000000-0000-0000-0000-000000000002
HORECAOS_STOREFRONT_LOCATION_ID=10000000-0000-0000-0000-000000000003
HORECAOS_YANDEX_MAPS_API_KEY=smoke-test-not-a-real-key

# --- Kafka -------------------------------------------------------------------

HORECAOS_KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Object storage ----------------------------------------------------------

HORECAOS_MINIO_ROOT_USER=horecaos-smoke-root
HORECAOS_MEDIA_BUCKET=horecaos-smoke-media
HORECAOS_MEDIA_REGION=us-east-1

# --- Backups -----------------------------------------------------------------
#
# Left unset on purpose. The nightly backup job is not exercised by this
# script (deploy/local-smoke.sh proves the platform boots and answers
# requests, not the backup/restore path, which platform/infra/backup already
# has its own rehearsal script for — see production-setup.md's Backups
# section). Leaving these empty means `ops` would refuse to run a real
# backup here, which is the correct behaviour to inherit unmodified.
HORECAOS_BACKUP_BUCKET=horecaos-smoke-backups
HORECAOS_BACKUP_S3_ENDPOINT=http://minio:9000
HORECAOS_BACKUP_RETENTION_DAYS=1
HORECAOS_BACKUP_OFFSITE_ENDPOINT=
HORECAOS_BACKUP_OFFSITE_BUCKET=

# --- Sizing ------------------------------------------------------------------
#
# `deploy:` resource limits are Swarm/`--compatibility` syntax; plain
# `docker compose up` does not enforce them at all, so these values are
# never exercised here regardless of what they are set to — left at the
# template's defaults intentionally rather than tuned for a laptop.
