# The RAM-backed directory the startup secrets live in (ADR 0080).
#
# A unit of its own rather than a `mount` run by horecaos-boot.service: a
# service can be given a private mount namespace, and a tmpfs mounted from
# inside one is invisible to the Docker daemon -- every container would then
# bind-mount an empty directory and crash-loop exactly as if nothing had run.
# PID 1 mounts this in the host's namespace, where dockerd sees it.
#
# The same size, mode and flags session-start.sh uses when it mounts the
# directory itself on a host that has not enrolled.

[Unit]
Description=HorecaOS startup-secret tmpfs

[Mount]
What=tmpfs
Where=/run/horecaos/secrets
Type=tmpfs
Options=size=1m,mode=0700,noexec,nosuid,nodev
