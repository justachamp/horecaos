# The only process on this host that listens on a public port.
#
# Caddy rather than nginx for one reason that matters to a single operator:
# certificate issuance and renewal happen without a cron job, without
# certbot, and without a renewal that silently stops working eight weeks
# before anyone notices. An expired certificate is a full outage, and it is
# the single most common self-inflicted one on deployments like this.
#
# The nginx alternative (rejected, not forgotten): nginx as the reverse
# proxy with certbot as a sidecar renewing into a shared volume works too,
# and some operators will already know nginx better than Caddy. It was not
# chosen because it is two containers and a renewal timer doing what Caddy
# does as one container with zero extra moving parts — worth revisiting only
# if this deployment ever needs an nginx-specific module (a WAF rule
# language, a very particular proxy_pass rewrite) that Caddy has no
# equivalent for.

{
	email {$HORECAOS_ACME_EMAIL}

	admin 127.0.0.1:2019

	servers {
		trusted_proxies static private_ranges
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?redacted"
			}
		}
	}
}

{$HORECAOS_API_ORIGIN} {
	tls {$HORECAOS_TLS_MODE}

	encode zstd gzip

	handle /actuator/health/readiness {
		reverse_proxy platform-app:8080
	}

	handle /actuator/health/customer {
		reverse_proxy platform-app:8080
	}

	handle /actuator/* {
		respond 404
	}

	handle {
		reverse_proxy platform-app:8080 {
			lb_try_duration 10s
			health_uri /actuator/health/readiness
			health_interval 10s
			health_timeout 3s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?redacted"
			}
		}
	}
}

{$HORECAOS_AUTH_ORIGIN} {
	tls {$HORECAOS_TLS_MODE}

	encode zstd gzip

	handle /admin/* {
		respond 404
	}

	handle /metrics* {
		respond 404
	}

	handle {
		reverse_proxy keycloak:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?redacted"
			}
		}
	}
}

# ---------------------------------------------------------------------------
# Media objects. A presigned URL is signed for one origin; the reverse proxy
# below carries no header rewriting so the Host MinIO validates against never
# changes. See the `media` network note in deploy/compose.production.yml.
# ---------------------------------------------------------------------------
{$HORECAOS_MEDIA_ORIGIN} {
	tls {$HORECAOS_TLS_MODE}

	encode zstd gzip

	handle /minio/* {
		respond 404
	}

	handle {
		reverse_proxy minio:9000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?redacted"
			}
		}
	}
}

